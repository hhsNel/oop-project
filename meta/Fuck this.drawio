<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="h3fG0v1rvNbDY_3xoh8J">
    <mxGraphModel dx="8360" dy="4680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml isekai-doom\n\nskinparam classAttributeIconSize 0\nskinparam groupInheritance 3\nskinparam linetype ortho\nhide circle\nhide empty members\n\n&#39; ─────────────────────────────────────────────\n&#39;  MATH\n&#39; ─────────────────────────────────────────────\npackage math {\n\n    class vec2 {\n        + x : float\n        + y : float\n        --\n        + vec2(X : float, Y : float)\n        + operator+(other : vec2) : vec2\n        + operator-(other : vec2) : vec2\n        + operator*(scalar : float) : vec2\n        + operator/(scalar : float) : vec2\n        + operator==(other : vec2) : bool\n        + len() : float\n        + sqr_len() : float\n        + normalized() : vec2\n        + perpendicular() : vec2\n        + angle() : float\n        + {static} dot_product(a : vec2, b : vec2) : float\n        + {static} rotate(v : vec2, angle : float) : vec2\n    }\n\n    class vec3 {\n        + x : float\n        + y : float\n        + z : float\n        --\n        + vec3(X : float, Y : float, Z : float)\n        + operator+(other : vec3) : vec3\n        + operator*(scalar : float) : vec3\n        + len() : float\n        + normalized() : vec3\n        + {static} dot_product(a : vec3, b : vec3) : float\n        + {static} cross_product(a : vec3, b : vec3) : vec3\n    }\n\n    class ray2 {\n        + origin : vec2\n        + direction : vec2\n        --\n        + ray2(e : vec2, d : vec2)\n        + intersects(seg : segment, hit_point : vec2&amp;, dist : float&amp;, seg_len : float&amp;) : bool\n        + {static} rotate(ray : ray2, angle : float) : ray2\n    }\n\n    class segment {\n        + point0 : vec2\n        + point1 : vec2\n        --\n        + segment(p0 : vec2, p1 : vec2)\n        + angle() : float\n        + midpoint() : vec2\n        + len() : float\n        + sqr_len() : float\n    }\n\n    ray2 --&gt; vec2\n    segment --&gt; vec2\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  UTIL\n&#39; ─────────────────────────────────────────────\npackage util {\n\n    class \&quot;indexed_storage&lt;T&gt;\&quot; as indexed_storage {\n        + nullid : id_t\n        --\n        + add(object : T) : id_t\n        + remove(id : id_t) : void\n        + operator[](id : id_t) : T&amp;\n        + contains(id : id_t) : bool\n        + size() : id_t\n    }\n\n    class resource {\n        + begin : void const*\n        + end : void const*\n        + size : size_t\n        --\n        + resource(begin_ptr : void const*, end_ptr : void const*)\n    }\n\n    class file_resource {\n        - file_data : vector&lt;byte&gt;\n        --\n        + file_resource(data : vector&lt;byte&gt;)\n    }\n\n    class resource_loader {\n        - symbol_cache : unordered_map&lt;string, void*&gt;\n        - resource_cache : unordered_map&lt;string, unique_ptr&lt;resource&gt;&gt;\n        --\n        + lookup_resource(name : string_view) : resource*\n    }\n\n    file_resource --|&gt; resource\n    resource_loader ..&gt; resource : creates\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  GRAPHICS\n&#39; ─────────────────────────────────────────────\npackage graphics {\n\n    class texture {\n        + pixels : vector&lt;uint32_t&gt;\n        + width : uint32_t\n        + height : uint32_t\n        + has_transparency : bool\n        --\n        + {static} load_from_bin(res : resource) : texture\n    }\n\n    class texture_set {\n        - wall_textures : vector&lt;texture&gt;\n        - sprite_textures : vector&lt;texture&gt;\n        - flat_textures : vector&lt;texture&gt;\n        --\n        + {static} load(resld : resource_loader&amp;, meta_path : string_view) : texture_set\n        + wall_tx_by_id(id : texture_id) : texture const&amp;\n        + sprite_tx_by_id(id : texture_id) : texture const&amp;\n        + flat_tx_by_id(id : texture_id) : texture const&amp;\n    }\n\n    class texture_manager {\n        - texture_sets : vector&lt;texture_set&gt;\n        - cur_set : unsigned int\n        --\n        + {static} load(resld : resource_loader&amp;) : texture_manager\n        + cycle_set() : void\n        + wall_tx_by_id(id : texture_id) : texture const&amp;\n        + sprite_tx_by_id(id : texture_id) : texture const&amp;\n        + flat_tx_by_id(id : texture_id) : texture const&amp;\n    }\n\n    texture_set \&quot;1\&quot; *-- \&quot;*\&quot; texture\n    texture_manager \&quot;1\&quot; *-- \&quot;*\&quot; texture_set\n    texture_set ..&gt; resource_loader : uses\n    texture ..&gt; resource : loads from\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  RENDERING\n&#39; ─────────────────────────────────────────────\npackage rendering {\n\n    class sprite {\n        + pos : vec2\n        + z_pos : float\n        + tex_id : texture_id\n        + inherent_scale : float\n        --\n        + sprite(p : vec2, z : float, tex : texture_id, is : float)\n        + sprite()\n    }\n\n    class visplane {\n        + height : float\n        + tex_id : texture_id\n        + light_level : uint8_t\n        + min_x : int\n        + max_x : int\n        + top : vector&lt;int&gt;\n        + bottom : vector&lt;int&gt;\n        --\n        + visplane(x : int, sw : unsigned int, h : float, tid : texture_id, light : uint8_t)\n    }\n\n    class vissprite {\n        + depth : float\n        + cx1 : int\n        + cx2 : int\n        + proj_x : float\n        + scale : float\n        + z_pos : float\n        + tex_id : texture_id\n        + light_level : uint8_t\n        --\n        + vissprite(spr : sprite const&amp;, z : float, cx1 : int, cx2 : int, px : float, sc : float, light : uint8_t, uc : vector&lt;int&gt;, lc : vector&lt;int&gt;)\n    }\n\n    class rendering_mode {\n        + x_res : unsigned int\n        + y_res : unsigned int\n        + refresh_hz : unsigned int\n        + has_vsync : bool\n    }\n\n    abstract class rendering_backend {\n        # bad : bool\n        --\n        + {abstract} get_modes() : vector&lt;rendering_mode&gt;\n        + {abstract} set_mode(mode : rendering_mode) : void\n        + {abstract} flush() : void\n        + {abstract} get_mmio() : uint32_t*\n        + is_bad() : bool\n    }\n\n    class software_renderer {\n        - target : rendering_backend*\n        - tex_manager : texture_manager const*\n        - current_map : map_data const*\n        - visplanes : vector&lt;visplane&gt;\n        - vissprites : vector&lt;vissprite&gt;\n        --\n        + set_target(tgt : rendering_backend*) : void\n        + set_texture_manager(tm : texture_manager const*) : void\n        + set_map(map : map_data const*) : void\n        + render_bsp(cam_pos : vec2, cam_height : float, cam_angle : float, fov : float) : void\n    }\n\n    class renderer_2d {\n        - target : rendering_backend*\n        - tex_manager : texture_manager const*\n        - font_texture : texture const*\n        --\n        + set_target(tgt : rendering_backend*) : void\n        + set_texture_manager(tm : texture_manager const*) : void\n        + set_font_texture(font_tex : texture const*) : void\n        + draw_texture(tex : texture const&amp;, x : int, y : int, w : int, h : int) : void\n        + draw_text(text : string_view, x : int, y : int, char_w : int, char_h : int, color : uint32_t) : void\n        + draw_rect(x : int, y : int, w : int, h : int, color : uint32_t) : void\n    }\n\n    package drm_kms {\n        class drm_rendering_mode {\n            + kernel_mode : drm_mode_modeinfo\n            --\n            + drm_rendering_mode(info : drm_mode_modeinfo&amp;)\n        }\n\n        class drm_backend {\n            --\n            + get_modes() : vector&lt;rendering_mode&gt;\n            + set_mode(mode : rendering_mode) : void\n            + flush() : void\n            + get_mmio() : uint32_t*\n        }\n    }\n\n    drm_rendering_mode --|&gt; rendering_mode\n    drm_backend --|&gt; rendering_backend\n\n    software_renderer --&gt; rendering_backend : target\n    software_renderer --&gt; texture_manager : tex_manager\n    software_renderer \&quot;1\&quot; *-- \&quot;*\&quot; visplane\n    software_renderer \&quot;1\&quot; *-- \&quot;*\&quot; vissprite\n    vissprite --&gt; sprite : wraps\n    renderer_2d --&gt; rendering_backend : target\n    renderer_2d --&gt; texture_manager : tex_manager\n    sprite --&gt; vec2 : pos\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  INPUT\n&#39; ─────────────────────────────────────────────\npackage input {\n\n    enum key {\n        a .. z\n        n0 .. n9\n        f1 .. f12\n        esc\n        space\n        up / down / left / right\n        ...\n    }\n\n    class mouse_state {\n        + x : int\n        + y : int\n        + left : bool\n        + right : bool\n        + middle : bool\n    }\n\n    abstract class input_backend {\n        # bad : bool\n        --\n        + {abstract} update() : void\n        + {abstract} is_key_down(k : key) : bool\n        + {abstract} get_mouse_state() : mouse_state\n        + is_bad() : bool\n        + {static} to_key(c : char) : key\n    }\n\n    class evdev_backend {\n        - devices : vector&lt;device_node&gt;\n        - key_map : bitset&lt;KEY_CNT&gt;\n        - mouse : mouse_state\n        --\n        + evdev_backend()\n        + update() : void\n        + is_key_down(k : key) : bool\n        + get_mouse_state() : mouse_state\n    }\n\n    evdev_backend --|&gt; input_backend\n    input_backend --&gt; key\n    input_backend --&gt; mouse_state\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  GEOMETRY\n&#39; ─────────────────────────────────────────────\npackage geometry {\n\n    class sector {\n        + floor_height : float\n        + ceiling_height : float\n        + floor_tex : texture_id\n        + ceiling_tex : texture_id\n        + light_level : uint8_t\n        --\n        + {static} load_from_bin(res : resource) : vector&lt;sector&gt;\n    }\n\n    class sidedef {\n        + facing_sector : sector_id\n        + upper_tex : texture_id\n        + middle_tex : texture_id\n        + lower_tex : texture_id\n        --\n        + {static} load_from_bin(res : resource) : vector&lt;sidedef&gt;\n    }\n\n    class linedef {\n        + v1 : vec2\n        + v2 : vec2\n        + front : sidedef_id\n        + back : sidedef_id\n        --\n        + {static} load_from_bin(res : resource) : vector&lt;linedef&gt;\n    }\n\n    class subsector {\n        + lines : vector&lt;linedef_id&gt;\n        + sprites : vector&lt;unique_ptr&lt;sprite&gt;&gt;\n        --\n        + {static} load_from_bin(res : resource) : vector&lt;subsector&gt;\n    }\n\n    class bsp_node {\n        + pl_coord : vec2\n        + pl_dir : vec2\n        + front_box : bounding_box\n        + back_box : bounding_box\n        + front : id_t\n        + back : id_t\n        --\n        + is_front_leaf() : bool\n        + is_back_leaf() : bool\n        + is_pt_front_side(point : vec2 const&amp;) : bool\n        + {static} load_from_bin(res : resource) : vector&lt;bsp_node&gt;\n    }\n\n    class map_data {\n        + sectors : indexed_storage&lt;sector&gt;\n        + sidedefs : indexed_storage&lt;sidedef&gt;\n        + linedefs : indexed_storage&lt;linedef&gt;\n        + subsectors : indexed_storage&lt;subsector&gt;\n        + nodes : indexed_storage&lt;bsp_node&gt;\n        + root_node_id : id_t\n        --\n        + get_subsector_id(pt : vec2 const&amp;) : subsector_id\n        + move_to(spr : sprite*, new_pos : vec2 const&amp;) : void\n        + {static} load_from_bin(sectors_res : resource, ...) : map_data\n    }\n\n    sidedef --&gt; sector : facing_sector\n    linedef --&gt; sidedef : front / back\n    linedef --&gt; vec2 : v1 / v2\n    subsector --&gt; linedef : lines\n    subsector \&quot;1\&quot; o-- \&quot;*\&quot; sprite : sprites\n    bsp_node --&gt; vec2 : pl_coord / pl_dir\n    map_data \&quot;1\&quot; *-- \&quot;*\&quot; sector\n    map_data \&quot;1\&quot; *-- \&quot;*\&quot; sidedef\n    map_data \&quot;1\&quot; *-- \&quot;*\&quot; linedef\n    map_data \&quot;1\&quot; *-- \&quot;*\&quot; subsector\n    map_data \&quot;1\&quot; *-- \&quot;*\&quot; bsp_node\n\n    software_renderer --&gt; map_data : current_map\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  COMBAT — status effects\n&#39; ─────────────────────────────────────────────\npackage combat {\n\n    abstract class status_effect {\n        # duration : float\n        # intensity : unsigned int\n        # tick_interval : float\n        # tick_timer : float\n        --\n        + status_effect(dur : float, tick_inter : float, intens : unsigned int)\n        + on_apply(target : actor&amp;) : void\n        + affect(target : actor&amp;) : void\n        + on_expire(target : actor&amp;) : void\n        + update(dt : float) : bool\n        + is_expired() : bool\n    }\n\n    class burning {\n        --\n        + burning(dur : float, intens : unsigned int)\n        + affect(target : actor&amp;) : void\n    }\n\n    class slowed {\n        --\n        + slowed(dur : float, intens : unsigned int)\n        + on_apply(target : actor&amp;) : void\n        + on_expire(target : actor&amp;) : void\n    }\n\n    class charmed {\n        --\n        + charmed(dur : float, intens : unsigned int)\n        + on_apply(target : actor&amp;) : void\n        + on_expire(target : actor&amp;) : void\n    }\n\n    burning --|&gt; status_effect\n    slowed --|&gt; status_effect\n    charmed --|&gt; status_effect\n\n&#39; ─────────────────────────────────────────────\n&#39;  COMBAT — weapons &amp; ammo\n&#39; ─────────────────────────────────────────────\n    package weapons {\n\n        abstract class ammunition {\n            --\n            + {abstract} spawn_bullet(pos : vec2, angle : float, damage : float) : void\n            + update(dt : float) : void\n        }\n\n        abstract class weapon {\n            + weapon_id : unsigned int\n            + ammo_count : int\n            + max_ammo : int\n            + fire_rate : float\n            + last_shot_time : float\n            + damage : float\n            # ammo : unique_ptr&lt;ammunition&gt;\n            --\n            # weapon(id : unsigned int, ammo_type : unique_ptr&lt;ammunition&gt;, mag : int, max : int, rate : float, dmg : float)\n            + can_fire() : bool\n            + update(dt : float) : void\n            + {abstract} fire(pos : vec2, angle : float) : void\n            + {abstract} reload() : void\n        }\n\n        class bullet_ammunition {\n            + spawned : vector&lt;bullet_record&gt;\n            --\n            + spawn_bullet(pos : vec2, angle : float, damage : float) : void\n        }\n\n        class hitscan_ammunition {\n            + targets : vector&lt;actor*&gt;\n            - map : map_data*\n            - max_range : float\n            - hit_radius : float\n            --\n            + hitscan_ammunition(map : map_data*, range : float, radius : float)\n            + spawn_bullet(pos : vec2, angle : float, damage : float) : void\n        }\n\n        class plasma_ammunition {\n            + spawned : vector&lt;plasma_record&gt;\n            --\n            + spawn_bullet(pos : vec2, angle : float, damage : float) : void\n        }\n\n        class grenade_ammunition {\n            + active : vector&lt;live_grenade&gt;\n            + targets : vector&lt;actor*&gt;\n            - map : map_data*\n            - fuse_time : float\n            - explosion_radius : float\n            - throw_speed : float\n            --\n            + grenade_ammunition(map : map_data*, fuse : float, radius : float, speed : float)\n            + spawn_bullet(pos : vec2, angle : float, damage : float) : void\n            + update(dt : float) : void\n            - explode(g : live_grenade) : void\n        }\n\n        class pistol {\n            --\n            + pistol(ammo : unique_ptr&lt;ammunition&gt;, mag : int, max : int, rate : float, dmg : float)\n            + fire(pos : vec2, angle : float) : void\n            + reload() : void\n        }\n\n        class smg {\n            --\n            + smg(ammo : unique_ptr&lt;ammunition&gt;, mag : int, max : int, rate : float, dmg : float)\n            + fire(pos : vec2, angle : float) : void\n            + reload() : void\n        }\n\n        class rifle {\n            --\n            + rifle(ammo : unique_ptr&lt;ammunition&gt;, mag : int, max : int, rate : float, dmg : float)\n            + fire(pos : vec2, angle : float) : void\n            + reload() : void\n        }\n\n        class shotgun {\n            + {static} pellet_count : int = 8\n            + {static} spread : float = 0.2618\n            --\n            + shotgun(ammo : unique_ptr&lt;ammunition&gt;, mag : int, max : int, rate : float, dmg : float)\n            + fire(pos : vec2, angle : float) : void\n            + reload() : void\n        }\n\n        class sniper_rifle {\n            --\n            + sniper_rifle(ammo : unique_ptr&lt;ammunition&gt;, mag : int, max : int, rate : float, dmg : float)\n            + fire(pos : vec2, angle : float) : void\n            + reload() : void\n        }\n\n        class plasma_gun {\n            --\n            + plasma_gun(ammo : unique_ptr&lt;ammunition&gt;, mag : int, max : int, rate : float, dmg : float)\n            + fire(pos : vec2, angle : float) : void\n            + reload() : void\n        }\n\n        class katana {\n            + swing_count : int\n            --\n            + katana(rate : float, dmg : float)\n            + can_fire() : bool\n            + fire(pos : vec2, angle : float) : void\n            + reload() : void\n        }\n\n        class grenade_weapon {\n            --\n            + grenade_weapon(ammo : unique_ptr&lt;ammunition&gt;, count : int, max_count : int, rate : float, dmg : float)\n            + fire(pos : vec2, angle : float) : void\n            + reload() : void\n        }\n\n        bullet_ammunition --|&gt; ammunition\n        hitscan_ammunition --|&gt; ammunition\n        plasma_ammunition --|&gt; ammunition\n        grenade_ammunition --|&gt; ammunition\n\n        pistol --|&gt; weapon\n        smg --|&gt; weapon\n        rifle --|&gt; weapon\n        shotgun --|&gt; weapon\n        sniper_rifle --|&gt; weapon\n        plasma_gun --|&gt; weapon\n        katana --|&gt; weapon\n        grenade_weapon --|&gt; weapon\n\n        weapon \&quot;1\&quot; *-- \&quot;1\&quot; ammunition : ammo\n        hitscan_ammunition --&gt; map_data : map\n        grenade_ammunition --&gt; map_data : map\n    }\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  SYSTEMS\n&#39; ─────────────────────────────────────────────\npackage systems {\n\n    class health_system {\n        + current_hp : float\n        + max_hp : float\n        + armor : float\n        + max_armor : float\n        + active_effects : vector&lt;unique_ptr&lt;status_effect&gt;&gt;\n        --\n        + apply_damage(amount : float) : void\n        + apply_heal(amount : float) : void\n        + apply_shield(amount : float) : void\n        + is_dead() : bool\n        + add_effect(effect : unique_ptr&lt;status_effect&gt;, owner : actor&amp;) : void\n        + process_effects(dt : float, owner : actor&amp;) : void\n    }\n\n    health_system \&quot;1\&quot; o-- \&quot;*\&quot; status_effect : active_effects\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  ENGINE\n&#39; ─────────────────────────────────────────────\npackage engine {\n\n    abstract class entity {\n        --\n        + {abstract} update(dt : float) : void\n    }\n\n    class renderable_entity {\n        --\n        + renderable_entity(p : vec2, z : float, tex : texture_id, is : float)\n        + renderable_entity()\n    }\n\n    enum faction {\n        player\n        enemy\n        neutral\n    }\n\n    abstract class actor {\n        + angle : float\n        + movement_speed : float\n        + team : faction\n        # health : health_system\n        --\n        + actor(hp : float, shield : float, move_speed : float, team : faction)\n        + take_damage(dmg : float) : void\n        + take_true_damage(dmg : float) : void\n        + heal(amount : float) : void\n        + add_shield(amount : float) : void\n        + add_effect(effect : unique_ptr&lt;status_effect&gt;) : void\n        + is_dead() : bool\n        + update(dt : float) : void\n    }\n\n    class world {\n        - entities : indexed_storage&lt;unique_ptr&lt;entity&gt;&gt;\n        - deleted_entities : vector&lt;id_t&gt;\n        --\n        + world()\n        + update(dt : float) : void\n        + register_entity(e : unique_ptr&lt;entity&gt;) : id_t\n        + delete_entity(id : id_t) : void\n        + entity_from_id(id : id_t) : entity*\n        + operator[](id : id_t) : entity&amp;\n        + get_entities() : indexed_storage const&amp;\n    }\n\n    renderable_entity --|&gt; entity\n    renderable_entity --|&gt; sprite\n    actor --|&gt; renderable_entity\n    actor \&quot;1\&quot; *-- \&quot;1\&quot; health_system : health\n    actor --&gt; faction\n    world \&quot;1\&quot; *-- \&quot;*\&quot; entity : entities\n    world ..&gt; indexed_storage : uses\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  ENTITIES\n&#39; ─────────────────────────────────────────────\npackage entities {\n\n    abstract class monster {\n        + attack_range : float\n        + detection_radius : float\n        + attack_damage : float\n        + attack_cd_max : float\n        # target_ptr : weak_ptr&lt;actor&gt;\n        # attack_cooldown : float\n        --\n        + monster(hp : float, shield : float, move_speed : float, atk_range : float, det_radius : float)\n        + set_target(t : shared_ptr&lt;actor&gt;) : void\n        + update(dt : float) : void\n        + take_damage(dmg : float) : void\n        # has_target() : bool\n        # dist_to_target() : float\n        # dir_to_target() : vec2\n        # move_toward_target(speed : float, dt : float) : void\n        # move_away_from_target(speed : float, dt : float) : void\n        # strafe(speed : float, sign : float, dt : float) : void\n        # melee_attack(damage : float) : void\n    }\n\n    class monster_basic {\n        --\n        + monster_basic()\n        + update(dt : float) : void\n    }\n    class monster_ranged {\n        + preferred_dist : float\n        --\n        + monster_ranged()\n        + update(dt : float) : void\n    }\n    class monster_assault {\n        + burst_size : int\n        + burst_interval : float\n        + burst_remaining : int\n        + burst_timer : float\n        + burst_cooldown : float\n        + strafe_sign : float\n        + strafe_timer : float\n        --\n        + monster_assault()\n        + update(dt : float) : void\n    }\n    class monster_sniper {\n        + shoot_interval : float\n        + aim_timer : float\n        --\n        + monster_sniper()\n        + update(dt : float) : void\n    }\n    class monster_trapper {\n        + max_traps : int\n        + traps_placed : int\n        + trap_timer : float\n        + trap_interval : float\n        + wander_timer : float\n        + wander_sign : float\n        --\n        + monster_trapper()\n        + update(dt : float) : void\n    }\n    class monster_Duzy_Gruby {\n        --\n        + monster_Duzy_Gruby()\n        + update(dt : float) : void\n    }\n    class monster_Maly_Szybki {\n        + is_dashing : bool\n        + dash_timer : float\n        + dash_cooldown : float\n        --\n        + monster_Maly_Szybki()\n        + update(dt : float) : void\n    }\n    class monster_all_rounder {\n        + melee_mode : bool\n        + melee_threshold : float\n        --\n        + monster_all_rounder()\n        + update(dt : float) : void\n    }\n    class monster_spawner {\n        + max_spawns : int\n        + current_spawns : int\n        + spawn_interval : float\n        + spawn_timer : float\n        --\n        + monster_spawner()\n        + update(dt : float) : void\n    }\n    class monster_magic {\n        + charge_time : float\n        + charge_timer : float\n        + is_charging : bool\n        + post_fire_cooldown : float\n        + sidestep_timer : float\n        + sidestep_sign : float\n        --\n        + monster_magic()\n        + update(dt : float) : void\n    }\n    class monster_elite_tank {\n        + melee_mode : bool\n        + melee_threshold : float\n        + heavy_timer : float\n        + heavy_cd : float\n        --\n        + monster_elite_tank()\n        + update(dt : float) : void\n    }\n    class monster_elite_swift {\n        + charge_speed : float\n        + is_charging : bool\n        + charge_timer : float\n        + charge_cd : float\n        + circle_angle : float\n        + circle_radius : float\n        --\n        + monster_elite_swift()\n        + update(dt : float) : void\n    }\n    class monster_boss {\n        + phase_count : int\n        --\n        + monster_boss()\n    }\n\n    class player {\n        + sensitivity : float\n        + current_weapon_index : int\n        + weapons : vector&lt;weapon*&gt;\n        + current_weapon : weapon*\n        --\n        + player(hp : float, shield : float, move_speed : float, sens : float)\n        + update(dt : float) : void\n        + move(direction : vec3) : void\n        + rotate(yaw : float, pitch : float) : void\n        + shoot() : void\n        + reload() : void\n        + switch_weapons(index : int) : void\n        + use_grenade() : void\n        + take_damage(dmg : float) : void\n    }\n\n    monster --|&gt; actor\n    player --|&gt; actor\n    player \&quot;1\&quot; o-- \&quot;*\&quot; weapon : weapons\n\n    monster_basic --|&gt; monster\n    monster_ranged --|&gt; monster\n    monster_assault --|&gt; monster\n    monster_sniper --|&gt; monster\n    monster_trapper --|&gt; monster\n    monster_Duzy_Gruby --|&gt; monster\n    monster_Maly_Szybki --|&gt; monster\n    monster_all_rounder --|&gt; monster\n    monster_spawner --|&gt; monster\n    monster_magic --|&gt; monster\n    monster_elite_tank --|&gt; monster\n    monster_elite_swift --|&gt; monster\n    monster_boss --|&gt; monster\n\n    monster --&gt; actor : target_ptr\n}\n\n&#39; ─────────────────────────────────────────────\n&#39;  WORLD OBJECTS\n&#39; ─────────────────────────────────────────────\npackage world_object {\n\n    abstract class pickup {\n        + position : vec2\n        + pickup_radius : float\n        + collected : bool\n        --\n        + pickup(pos : vec2, radius : float)\n        + update(dt : float) : void\n        + in_range(player_pos : vec2) : bool\n        + {abstract} on_pickup(p : player&amp;) : void\n    }\n\n    class health_pickup {\n        + heal_amount : float\n        --\n        + health_pickup(pos : vec2, amount : float, radius : float)\n        + on_pickup(p : player&amp;) : void\n    }\n\n    class armor_pickup {\n        + armor_amount : float\n        --\n        + armor_pickup(pos : vec2, amount : float, radius : float)\n        + on_pickup(p : player&amp;) : void\n    }\n\n    class ammo_pickup {\n        + weapon_id : unsigned int\n        + amount : unsigned int\n        --\n        + ammo_pickup(pos : vec2, wid : unsigned int, amt : unsigned int, radius : float)\n        + on_pickup(p : player&amp;) : void\n    }\n\n    class weapon_pickup {\n        + provided_weapon : weapon*\n        --\n        + weapon_pickup(pos : vec2, w : weapon*, radius : float)\n        + on_pickup(p : player&amp;) : void\n    }\n\n    pickup --|&gt; entity\n    health_pickup --|&gt; pickup\n    armor_pickup --|&gt; pickup\n    ammo_pickup --|&gt; pickup\n    weapon_pickup --|&gt; pickup\n\n    pickup --&gt; player : on_pickup\n    weapon_pickup --&gt; weapon : provided_weapon\n}\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="xI9m2QQfApfT8fS93lNZ-2">
