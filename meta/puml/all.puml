        + play(clip : assets::audio_clip const&) : void
        + stop_all() : void
        + step(frames_to_mix : unsigned long) : void
        + is_silent() : bool
    }

    struct playing_sound << (S,#FF7700) internal >> {
        + clip : assets::audio_clip const*
        + current_frame : unsigned long
    }

    package alsa {
        class backend {
            - is_bad : bool
            - pcm_handle : snd_pcm_t*
