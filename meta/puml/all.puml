            + backend()
            + ~backend() override
            + open(format : audio_format const&) : bool override
            + close() : void override
            + write(data : void const*, frames : unsigned long) : long override
            + drain() : void override
            + pause() : void override
            + resume() : void override
            + operator()(tag : util::component_tag<"current_format">) : audio_format const override
            + bad() : bool override
        }
    }
}

