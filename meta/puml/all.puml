    abstract class audio_backend {
        + {abstract} ~audio_backend()
        + {abstract} open(fmt : audio_format const&) : bool
        + {abstract} close() : void
        + {abstract} write(data : void const*, frames : unsigned long) : long
        + {abstract} drain() : void
