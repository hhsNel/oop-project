@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome true

package util {
    class "componentized<T>" as componentized {
    }
    class "indexed_storage<T>" as indexed_storage {
    }
    class resource {
    }
}

package assets {
    class texture_id << (D,#FF7700) typedef >>
}

package rendering {
    class sprite {
    }
    class software_renderer {
    }
}

package math {
    class vec2 {
    }
    class segment {
    }
}

package geometry {

    '' ========================================================
    '' subsector.h
    '' ========================================================
    class subsector {
        - lines : std::vector<util::indexed_storage<linedef>::id_t>
        - sprites : std::vector<std::unique_ptr<rendering::sprite>>
        + subsector()
        + subsector(l : std::vector<util::indexed_storage<linedef>::id_t>, s : std::vector<std::unique_ptr<rendering::sprite>>)
        + {static} load_from_bin(res : util::resource const&) : std::vector<subsector>
        + remove_sprite(spr : rendering::sprite*) : std::unique_ptr<rendering::sprite>
        + add_sprite(spr : std::unique_ptr<rendering::sprite>) : void
        -- Friends --
        friend rendering::software_renderer
    }

    '' ========================================================
    '' sector.h
    '' ========================================================
    class sector {
        - floor_height : float
        - ceiling_height : float
        - floor_tex : assets::texture_id
        - ceiling_tex : assets::texture_id
        - light_level : std::uint8_t
        + sector(fh : float, ch : float, ft : assets::texture_id, ct : assets::texture_id, light : std::uint8_t)
        + {static} load_from_bin(res : util::resource const&) : std::vector<sector>
        -- Friends --
        friend rendering::software_renderer
    }

    '' ========================================================
    '' sidedef.h
    '' ========================================================
    class sidedef {
        - facing_sector : util::indexed_storage<sector>::id_t
        - upper_tex : assets::texture_id
        - middle_tex : assets::texture_id
        - lower_tex : assets::texture_id
        + sidedef(sector : util::indexed_storage<sector>::id_t, ut : assets::texture_id, mt : assets::texture_id, lt : assets::texture_id)
        + {static} load_from_bin(res : util::resource const&) : std::vector<sidedef>
        -- Friends --
        friend rendering::software_renderer
    }

    '' ========================================================
    '' bsp-node.h
    '' ========================================================
    class bsp_node {
        - pl_coord : math::vec2
        - pl_dir : math::vec2
        - front_box : bounding_box
        - back_box : bounding_box
        - front : util::indexed_storage<bsp_node>::id_t
        - back : util::indexed_storage<bsp_node>::id_t
        - {static} constexpr leaf_flag : util::indexed_storage<bsp_node>::id_t
        + is_front_leaf() : bool const
        + is_back_leaf() : bool const
        + get_front_index() : util::indexed_storage<bsp_node>::id_t const
        + get_back_index() : util::indexed_storage<bsp_node>::id_t const
        + is_pt_front_side(point : math::vec2 const&) : bool
        + bsp_node(pc : math::vec2 const, pd : math::vec2 const, fb : bounding_box const, bb : bounding_box const, f : util::indexed_storage<bsp_node>::id_t, b : util::indexed_storage<bsp_node>::id_t)
        + {static} load_from_bin(res : util::resource const&) : std::vector<bsp_node> const
        + {static} inline constexpr is_leaf(id : util::indexed_storage<bsp_node>::id_t const) : bool
        + {static} inline constexpr get_id(raw : util::indexed_storage<bsp_node>::id_t const) : util::indexed_storage<bsp_node>::id_t
        -- Friends --
        friend rendering::software_renderer
    }

    struct "bsp_node::bounding_box" as bounding_box {
        + top : float
        + bottom : float
        + left : float
        + right : float
    }

    '' ========================================================
    '' linedef.h
    '' ========================================================
    class linedef {
        - seg : math::segment
        - front : util::indexed_storage<sidedef>::id_t
        - back : util::indexed_storage<sidedef>::id_t
        + linedef(p0 : math::vec2 const, p1 : math::vec2 const, f : util::indexed_storage<sidedef>::id_t const, b : util::indexed_storage<sidedef>::id_t const)
        + {static} load_from_bin(res : util::resource const&) : std::vector<linedef>
        + is_wall() : bool const
        + is_portal() : bool const
        + dir() : math::vec2 const
        + len() : float const
        -- Friends --
        friend util::componentized<linedef>
        friend rendering::software_renderer
    }

    '' ========================================================
    '' map-data.h
    '' ========================================================
    class map_data {
        + sectors : util::indexed_storage<sector>
        + sidedefs : util::indexed_storage<sidedef>
        + linedefs : util::indexed_storage<linedef>
        + subsectors : util::indexed_storage<subsector>
        + nodes : util::indexed_storage<bsp_node>
        + root_node_id : util::indexed_storage<bsp_node>::id_t
        + get_subsector_id(pt : math::vec2 const&) : util::indexed_storage<subsector>::id_t const
        + move_to(spr : rendering::sprite*, new_pos : math::vec2 const&) : void
        + {static} load_from_bin(sectors_res : util::resource const&, sidedefs_res : util::resource const&, linedefs_res : util::resource const&, subsectors_res : util::resource const&, nodes_res : util::resource const&) : map_data
    }
}

'' Inner Type Definitions
bsp_node +-- bounding_box

'' Inheritance Architecture
linedef --|> util::componentized

'' Composition / Storage Allocations
map_data *-- "many" util::indexed_storage : hosts elements map layout
subsector *-- "many" rendering::sprite : retains active sprite entities
bsp_node *-- "2" math::vec2 : splits evaluation plane vectors
linedef *-- math::segment : maps concrete math geometry

'' Package Cross-Link Associations
sector ..> assets::texture_id : tracks reference layers
sidedef ..> assets::texture_id : tracks structural layers

@enduml