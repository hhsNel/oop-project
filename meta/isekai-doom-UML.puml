@startuml isekai-doom

skinparam classAttributeIconSize 0
skinparam groupInheritance 3
skinparam linetype ortho
hide circle
hide empty members

' ─────────────────────────────────────────────
'  MATH
' ─────────────────────────────────────────────
package math {

    class vec2 {
        + x : float
        + y : float
        --
        + vec2(X : float, Y : float)
        + vec2(vec : vec3 const&)
        + operator+(other : vec2) : vec2
        + operator-(other : vec2) : vec2
        + operator-() : vec2
        + operator*(scalar : float) : vec2
        + operator/(scalar : float) : vec2
        + operator+=(other : vec2) : vec2&
        + operator-=(other : vec2) : vec2&
        + operator*=(scalar : float) : vec2&
        + operator/=(scalar : float) : vec2&
        + operator==(other : vec2) : bool
        + operator!=(other : vec2) : bool
        + len() : float
        + sqr_len() : float
        + normalized() : vec2
        + perpendicular() : vec2
        + angle() : float
        + {static} dot_product(a : vec2, b : vec2) : float
        + {static} angle_between(a : vec2, b : vec2) : float
        + {static} rotate(v : vec2, angle : float) : vec2
        + {static} rotate_with_known_trig(v : vec2, cos : float, sin : float) : vec2
    }

    class vec3 {
        + x : float
        + y : float
        + z : float
        --
        + vec3(X : float, Y : float, Z : float)
        + vec3(flat : vec2, Z : float)
        + operator+(other : vec3) : vec3
        + operator-(other : vec3) : vec3
        + operator-() : vec3
        + operator*(scalar : float) : vec3
        + operator/(scalar : float) : vec3
        + operator+=(other : vec3) : vec3&
        + operator-=(other : vec3) : vec3&
        + operator*=(scalar : float) : vec3&
        + operator/=(scalar : float) : vec3&
        + operator==(other : vec3) : bool
        + operator!=(other : vec3) : bool
        + len() : float
        + sqr_len() : float
        + normalized() : vec3
        + {static} dot_product(a : vec3, b : vec3) : float
        + {static} cross_product(a : vec3, b : vec3) : vec3
    }

    class ray2 {
        + end : vec2
        + direction : vec2
        --
        + ray2(e : vec2, d : vec2)
        + operator==(other : ray2) : bool
        + operator!=(other : ray2) : bool
        + intersects(seg : segment, hit_point : vec2&, dist : float&, seg_len : float&) : bool
        + {static} rotate(ray : ray2, angle : float) : ray2
    }

    class segment {
        + point0 : vec2
        + point1 : vec2
        --
        + segment(p0 : vec2, p1 : vec2)
        + angle() : float
        + midpoint() : vec2
        + len() : float
        + sqr_len() : float
    }

    ray2 --> vec2
    segment --> vec2
}

' ─────────────────────────────────────────────
'  UTIL
' ─────────────────────────────────────────────
package util {

    class "indexed_storage<T>" as indexed_storage {
        + {static} nullid : id_t
        # objects : vector<T>
        # lookup : vector<id_t>
        # reverse : vector<size_t>
        # next_id : id_t
        --
        + indexed_storage()
        + indexed_storage(initial_objects : vector<T>)
        + add(object : T) : id_t
        + remove(id : id_t) : void
        + operator[](id : id_t) : T&
        + contains(id : id_t) : bool
        + size() : id_t
        + begin() : iterator
        + end() : iterator
        + cbegin() : const_iterator
        + cend() : const_iterator
        + erase(it : iterator) : iterator
    }

    class resource {
        + begin : void const*
        + end : void const*
        + size : size_t
        --
        + resource(begin_ptr : void const*, end_ptr : void const*)
    }

    class file_resource {
        - file_data : vector<byte>
        --
        + file_resource(data : vector<byte>)
    }

    class resource_loader {
        - symbol_cache : unordered_map<string, void*>
        - resource_cache : unordered_map<string, unique_ptr<resource>>
        - cache_mutex : mutex
        --
        + resource_loader()
        + lookup_resource(name : string_view) : resource*
    }

    file_resource --|> resource
    resource_loader ..> resource : creates
}

' ─────────────────────────────────────────────
'  GRAPHICS
' ─────────────────────────────────────────────
package graphics {

    class texture {
        + pixels : vector<uint32_t>
        + width : uint32_t
        + height : uint32_t
        + has_transparency : bool
        --
        - texture(t : vector<uint32_t>, w : uint32_t, h : uint32_t, transparent : bool)
        + {static} load_from_bin(res : resource) : texture
    }

    class texture_set {
        - wall_textures : vector<texture>
        - sprite_textures : vector<texture>
        - flat_textures : vector<texture>
        --
        - texture_set(walls : vector<texture>, sprites : vector<texture>, flat : vector<texture>)
        - {static} tx_from_meta(resld : resource_loader&, meta_path : string_view) : vector<texture>
        + {static} load(resld : resource_loader&, pack_meta_path : string_view) : texture_set
        + wall_tx_by_id(id : texture_id) : texture const&
        + sprite_tx_by_id(id : texture_id) : texture const&
        + flat_tx_by_id(id : texture_id) : texture const&
    }

    class texture_manager {
        - rl : resource_loader&
        - texture_sets : vector<texture_set>
        - cur_set : unsigned int
        --
        - texture_manager(resld : resource_loader&, packs : vector<texture_set>)
        + {static} load(resld : resource_loader&) : texture_manager
        + cycle_set() : void
        + wall_tx_by_id(id : texture_id) : texture const&
        + sprite_tx_by_id(id : texture_id) : texture const&
        + flat_tx_by_id(id : texture_id) : texture const&
    }

    texture_set "1" *-- "*" texture
    texture_manager "1" *-- "*" texture_set
    texture_set ..> resource_loader : uses
    texture ..> resource : loads from
}

' ─────────────────────────────────────────────
'  RENDERING
' ─────────────────────────────────────────────
package rendering {

    class sprite {
        + pos : vec2
        + z_pos : float
        + tex_id : texture_id
        + inherent_scale : float
        --
        + sprite(p : vec2, z : float, tex : texture_id, is : float)
        + sprite()
    }

    class visplane {
        + height : float
        + tex_id : texture_id
        + light_level : uint8_t
        + min_x : int
        + max_x : int
        + top : vector<int>
        + bottom : vector<int>
        --
        + visplane(x : int, sw : unsigned int, h : float, tid : texture_id, light : uint8_t)
    }

    class vissprite {
        + depth : float
        + cx1 : int
        + cx2 : int
        + proj_x : float
        + scale : float
        + z_pos : float
        + tex_id : texture_id
        + light_level : uint8_t
        --
        + vissprite(spr : sprite const&, z : float, cx1 : int, cx2 : int, px : float, sc : float, light : uint8_t, uc : vector<int>, lc : vector<int>)
    }

    class rendering_mode {
        + x_res : unsigned int
        + y_res : unsigned int
        + refresh_hz : unsigned int
        + has_vsync : bool
    }

    abstract class rendering_backend {
        # bad : bool
        --
        + rendering_backend()
        + {abstract} get_modes() : vector<unique_ptr<rendering_mode const>>
        + {abstract} set_mode(mode : unique_ptr<rendering_mode const>) : void
        + {abstract} get_width() : unsigned int
        + {abstract} get_height() : unsigned int
        + {abstract} get_pitch() : unsigned int
        + {abstract} get_mmio() : uint32_t*
        + {abstract} wait_for_vsync() : void
        + {abstract} flush() : void
        + is_bad() : bool
    }

    class software_renderer {
        - target : rendering_backend*
        - tex_manager : texture_manager const*
        - current_map : map_data const*
        - visplanes : vector<visplane>
        - vissprites : vector<vissprite>
        --
        + set_target(tgt : rendering_backend*) : void
        + set_texture_manager(tm : texture_manager const*) : void
        + set_map(map : map_data const*) : void
        + render_bsp(cam_pos : vec2, cam_height : float, cam_angle : float, fov : float) : void
    }

    class renderer_2d {
        - target : rendering_backend*
        - tex_manager : texture_manager const*
        - font_texture : texture const*
        --
        + set_target(tgt : rendering_backend*) : void
        + set_texture_manager(tm : texture_manager const*) : void
        + set_font_texture(font_tex : texture const*) : void
        + draw_texture(tex : texture const&, x : int, y : int, w : int, h : int) : void
        + draw_text(text : string_view, x : int, y : int, char_w : int, char_h : int, color : uint32_t) : void
        + draw_rect(x : int, y : int, w : int, h : int, color : uint32_t) : void
    }

    package drm_kms {
        class device_context {
            + fd : int
            --
            + device_context(path : string const&)
            + ~device_context()
            + is_valid() : bool
            + ioctl(request : unsigned long, arg : void*) : int
        }

        class connector {
            # dev : device_context const&
            # bad : bool
            + connector_id : uint32_t
            + encoder_id : uint32_t
            --
            + connector(d : device_context const&, id : uint32_t)
            + probe_modes() : vector<unique_ptr<drm_rendering_mode const>>
            + is_bad() : bool
        }

        class crtc {
            # dev : device_context const&
            + crtc_id : uint32_t
            --
            + crtc(d : device_context const&, id : uint32_t)
            + set_config(fb_id : uint32_t, conn_id : uint32_t, mode : drm_rendering_mode const&) : bool
        }

        class framebuffer {
            # dev : device_context const&
            # handle : uint32_t
            # bad : bool
            + fb_id : uint32_t
            + mmio_ptr : uint32_t*
            + size : size_t
            + pitch : uint32_t
            --
            + framebuffer(d : device_context const&, width : uint32_t, height : uint32_t)
            + ~framebuffer()
            + is_bad() : bool
        }

        class drm_rendering_mode {
            + kernel_mode : drm_mode_modeinfo
            --
            + drm_rendering_mode(info : drm_mode_modeinfo&)
        }

        class backend {
            # dev : unique_ptr<device_context>
            # active_connector : unique_ptr<connector>
            # active_crtc : unique_ptr<crtc>
            # buffers : framebuffer*[2]
            # front_buffer_index : int
            # shadow : vector<uint32_t>
            # current_mode : unique_ptr<drm_rendering_mode const>
            --
            + backend()
            + ~backend()
            + get_modes() : vector<unique_ptr<rendering_mode const>>
            + set_mode(mode : unique_ptr<rendering_mode const>) : void
            + is_bad() : bool
            + get_width() : unsigned int
            + get_height() : unsigned int
            + get_pitch() : unsigned int
            + get_mmio() : uint32_t*
            + wait_for_vsync() : void
            + flush() : void
        }

        connector --> device_context
        crtc --> device_context
        framebuffer --> device_context
        backend "1" *-- "1" device_context : dev
        backend "1" *-- "1" connector : active_connector
        backend "1" *-- "1" crtc : active_crtc
        backend "1" *-- "2" framebuffer : buffers
    }

    drm_rendering_mode --|> rendering_mode
    backend --|> rendering_backend

    software_renderer --> rendering_backend : target
    software_renderer --> texture_manager : tex_manager
    software_renderer "1" *-- "*" visplane
    software_renderer "1" *-- "*" vissprite
    vissprite --> sprite : wraps
    renderer_2d --> rendering_backend : target
    renderer_2d --> texture_manager : tex_manager
    sprite --> vec2 : pos
}

' ─────────────────────────────────────────────
'  INPUT
' ─────────────────────────────────────────────
package input {

    enum key {
        a .. z
        n0 .. n9
        f1 .. f12
        esc
        space
        up / down / left / right
        ...
    }

    class mouse_state {
        + x : int
        + y : int
        + left : bool
        + right : bool
        + middle : bool
    }

    abstract class input_backend {
        # bad : bool
        --
        + {abstract} update() : void
        + {abstract} is_key_down(k : key) : bool
        + {abstract} get_mouse_state() : mouse_state
        + is_bad() : bool
        + {static} to_key(c : char) : key
    }

    class evdev_backend {
        - devices : vector<device_node>
        - key_map : bitset<KEY_CNT>
        - mouse : mouse_state
        --
        + evdev_backend()
        + update() : void
        + is_key_down(k : key) : bool
        + get_mouse_state() : mouse_state
    }

    evdev_backend --|> input_backend
    input_backend --> key
    input_backend --> mouse_state
}

' ─────────────────────────────────────────────
'  GEOMETRY
' ─────────────────────────────────────────────
package geometry {

    class sector {
        + floor_height : float
        + ceiling_height : float
        + floor_tex : texture_id
        + ceiling_tex : texture_id
        + light_level : uint8_t
        --
        + {static} load_from_bin(res : resource) : vector<sector>
    }

    class sidedef {
        + facing_sector : sector_id
        + upper_tex : texture_id
        + middle_tex : texture_id
        + lower_tex : texture_id
        --
        + {static} load_from_bin(res : resource) : vector<sidedef>
    }

    class linedef {
        + v1 : vec2
        + v2 : vec2
        + front : sidedef_id
        + back : sidedef_id
        --
        + {static} load_from_bin(res : resource) : vector<linedef>
    }

    class subsector {
        + lines : vector<linedef_id>
        + sprites : vector<unique_ptr<sprite>>
        --
        + {static} load_from_bin(res : resource) : vector<subsector>
    }

    class bsp_node {
        + pl_coord : vec2
        + pl_dir : vec2
        + front_box : bounding_box
        + back_box : bounding_box
        + front : id_t
        + back : id_t
        + {static} leaf_flag : id_t
        --
        + is_front_leaf() : bool
        + is_back_leaf() : bool
        + get_front_index() : id_t
        + get_back_index() : id_t
        + is_pt_front_side(point : vec2 const&) : bool
        + {static} load_from_bin(res : resource) : vector<bsp_node>
    }

    class map_data {
        + sectors : indexed_storage<sector>
        + sidedefs : indexed_storage<sidedef>
        + linedefs : indexed_storage<linedef>
        + subsectors : indexed_storage<subsector>
        + nodes : indexed_storage<bsp_node>
        + root_node_id : id_t
        --
        + get_subsector_id(pt : vec2 const&) : subsector_id
        + move_to(spr : sprite*, new_pos : vec2 const&) : void
        + {static} load_from_bin(sectors_res : resource, ...) : map_data
    }

    sidedef --> sector : facing_sector
    linedef --> sidedef : front / back
    linedef --> vec2 : v1 / v2
    subsector --> linedef : lines
    subsector "1" o-- "*" sprite : sprites
    bsp_node --> vec2 : pl_coord / pl_dir
    map_data "1" *-- "*" sector
    map_data "1" *-- "*" sidedef
    map_data "1" *-- "*" linedef
    map_data "1" *-- "*" subsector
    map_data "1" *-- "*" bsp_node

    software_renderer --> map_data : current_map
}

' ─────────────────────────────────────────────
'  COMBAT — status effects
' ─────────────────────────────────────────────
package combat {

    abstract class status_effect {
        # duration : float
        # intensity : unsigned int
        # tick_interval : float
        # tick_timer : float
        --
        + status_effect(dur : float, tick_inter : float, intens : unsigned int)
        + on_apply(target : actor&) : void
        + affect(target : actor&) : void
        + on_expire(target : actor&) : void
        + update(dt : float) : bool
        + is_expired() : bool
    }

    class burning {
        --
        + burning(dur : float, intens : unsigned int)
        + affect(target : actor&) : void
    }

    class slowed {
        --
        + slowed(dur : float, intens : unsigned int)
        + on_apply(target : actor&) : void
        + on_expire(target : actor&) : void
    }

    class charmed {
        --
        + charmed(dur : float, intens : unsigned int)
        + on_apply(target : actor&) : void
        + on_expire(target : actor&) : void
    }

    burning --|> status_effect
    slowed --|> status_effect
    charmed --|> status_effect

' ─────────────────────────────────────────────
'  COMBAT — weapons & ammo
' ─────────────────────────────────────────────
    package weapons {

        abstract class ammunition {
            --
            + {abstract} spawn_bullet(pos : vec2, angle : float, damage : float) : void
            + update(dt : float) : void
        }

        abstract class weapon {
            + weapon_id : unsigned int
            + ammo_count : int
            + max_ammo : int
            + fire_rate : float
            + last_shot_time : float
            + damage : float
            # ammo : unique_ptr<ammunition>
            --
            # weapon(id : unsigned int, ammo_type : unique_ptr<ammunition>, mag : int, max : int, rate : float, dmg : float)
            + can_fire() : bool
            + update(dt : float) : void
            + {abstract} fire(pos : vec2, angle : float) : void
            + {abstract} reload() : void
        }

        class bullet_ammunition {
            + spawned : vector<bullet_record>
            --
            + spawn_bullet(pos : vec2, angle : float, damage : float) : void
        }

        class hitscan_ammunition {
            + targets : vector<actor*>
            - map : map_data*
            - max_range : float
            - hit_radius : float
            --
            + hitscan_ammunition(map : map_data*, range : float, radius : float)
            + spawn_bullet(pos : vec2, angle : float, damage : float) : void
        }

        class plasma_ammunition {
            + spawned : vector<plasma_record>
            --
            + spawn_bullet(pos : vec2, angle : float, damage : float) : void
        }

        class grenade_ammunition {
            + active : vector<live_grenade>
            + targets : vector<actor*>
            - map : map_data*
            - fuse_time : float
            - explosion_radius : float
            - throw_speed : float
            --
            + grenade_ammunition(map : map_data*, fuse : float, radius : float, speed : float)
            + spawn_bullet(pos : vec2, angle : float, damage : float) : void
            + update(dt : float) : void
            - explode(g : live_grenade) : void
        }

        class pistol {
            --
            + pistol(ammo : unique_ptr<ammunition>, mag : int, max : int, rate : float, dmg : float)
            + fire(pos : vec2, angle : float) : void
            + reload() : void
        }

        class smg {
            --
            + smg(ammo : unique_ptr<ammunition>, mag : int, max : int, rate : float, dmg : float)
            + fire(pos : vec2, angle : float) : void
            + reload() : void
        }

        class rifle {
            --
            + rifle(ammo : unique_ptr<ammunition>, mag : int, max : int, rate : float, dmg : float)
            + fire(pos : vec2, angle : float) : void
            + reload() : void
        }

        class shotgun {
            + {static} pellet_count : int = 8
            + {static} spread : float = 0.2618
            --
            + shotgun(ammo : unique_ptr<ammunition>, mag : int, max : int, rate : float, dmg : float)
            + fire(pos : vec2, angle : float) : void
            + reload() : void
        }

        class sniper_rifle {
            --
            + sniper_rifle(ammo : unique_ptr<ammunition>, mag : int, max : int, rate : float, dmg : float)
            + fire(pos : vec2, angle : float) : void
            + reload() : void
        }

        class plasma_gun {
            --
            + plasma_gun(ammo : unique_ptr<ammunition>, mag : int, max : int, rate : float, dmg : float)
            + fire(pos : vec2, angle : float) : void
            + reload() : void
        }

        class katana {
            + swing_count : int
            --
            + katana(rate : float, dmg : float)
            + can_fire() : bool
            + fire(pos : vec2, angle : float) : void
            + reload() : void
        }

        class grenade_weapon {
            --
            + grenade_weapon(ammo : unique_ptr<ammunition>, count : int, max_count : int, rate : float, dmg : float)
            + fire(pos : vec2, angle : float) : void
            + reload() : void
        }

        bullet_ammunition --|> ammunition
        hitscan_ammunition --|> ammunition
        plasma_ammunition --|> ammunition
        grenade_ammunition --|> ammunition

        pistol --|> weapon
        smg --|> weapon
        rifle --|> weapon
        shotgun --|> weapon
        sniper_rifle --|> weapon
        plasma_gun --|> weapon
        katana --|> weapon
        grenade_weapon --|> weapon

        weapon "1" *-- "1" ammunition : ammo
        hitscan_ammunition --> map_data : map
        grenade_ammunition --> map_data : map
    }
}

' ─────────────────────────────────────────────
'  SYSTEMS
' ─────────────────────────────────────────────
package systems {

    class health_system {
        + current_hp : float
        + max_hp : float
        + armor : float
        + max_armor : float
        + active_effects : vector<unique_ptr<status_effect>>
        --
        + apply_damage(amount : float) : void
        + apply_heal(amount : float) : void
        + apply_shield(amount : float) : void
        + is_dead() : bool
        + add_effect(effect : unique_ptr<status_effect>, owner : actor&) : void
        + process_effects(dt : float, owner : actor&) : void
    }

    health_system "1" o-- "*" status_effect : active_effects
}

' ─────────────────────────────────────────────
'  ENGINE
' ─────────────────────────────────────────────
package engine {

    abstract class entity {
        --
        + {abstract} update(dt : float) : void
    }

    class renderable_entity {
        --
        + renderable_entity(p : vec2, z : float, tex : texture_id, is : float)
        + renderable_entity()
    }

    enum faction {
        player
        enemy
        neutral
    }

    abstract class actor {
        + angle : float
        + movement_speed : float
        + team : faction
        # health : health_system
        --
        + actor(hp : float, shield : float, move_speed : float, team : faction)
        + take_damage(dmg : float) : void
        + take_true_damage(dmg : float) : void
        + heal(amount : float) : void
        + add_shield(amount : float) : void
        + add_effect(effect : unique_ptr<status_effect>) : void
        + is_dead() : bool
        + update(dt : float) : void
    }

    class world {
        - entities : indexed_storage<unique_ptr<entity>>
        - deleted_entities : vector<id_t>
        --
        + world()
        + update(dt : float) : void
        + register_entity(e : unique_ptr<entity>) : id_t
        + delete_entity(id : id_t) : void
        + entity_from_id(id : id_t) : entity*
        + operator[](id : id_t) : entity&
        + get_entities() : indexed_storage const&
    }

    renderable_entity --|> entity
    renderable_entity --|> sprite
    actor --|> renderable_entity
    actor "1" *-- "1" health_system : health
    actor --> faction
    world "1" *-- "*" entity : entities
    world ..> indexed_storage : uses
}

' ─────────────────────────────────────────────
'  ENTITIES
' ─────────────────────────────────────────────
package entities {

    abstract class monster {
        + attack_range : float
        + detection_radius : float
        + attack_damage : float
        + attack_cd_max : float
        # target_ptr : weak_ptr<actor>
        # attack_cooldown : float
        --
        + monster(hp : float, shield : float, move_speed : float, atk_range : float, det_radius : float)
        + set_target(t : shared_ptr<actor>) : void
        + update(dt : float) : void
        + take_damage(dmg : float) : void
        # has_target() : bool
        # dist_to_target() : float
        # dir_to_target() : vec2
        # move_toward_target(speed : float, dt : float) : void
        # move_away_from_target(speed : float, dt : float) : void
        # strafe(speed : float, sign : float, dt : float) : void
        # melee_attack(damage : float) : void
    }

    class monster_basic {
        --
        + monster_basic()
        + update(dt : float) : void
    }
    class monster_ranged {
        + preferred_dist : float
        --
        + monster_ranged()
        + update(dt : float) : void
    }
    class monster_assault {
        + burst_size : int
        + burst_interval : float
        + burst_remaining : int
        + burst_timer : float
        + burst_cooldown : float
        + strafe_sign : float
        + strafe_timer : float
        --
        + monster_assault()
        + update(dt : float) : void
    }
    class monster_sniper {
        + shoot_interval : float
        + aim_timer : float
        --
        + monster_sniper()
        + update(dt : float) : void
    }
    class monster_trapper {
        + max_traps : int
        + traps_placed : int
        + trap_timer : float
        + trap_interval : float
        + wander_timer : float
        + wander_sign : float
        --
        + monster_trapper()
        + update(dt : float) : void
    }
    class monster_Duzy_Gruby {
        --
        + monster_Duzy_Gruby()
        + update(dt : float) : void
    }
    class monster_Maly_Szybki {
        + is_dashing : bool
        + dash_timer : float
        + dash_cooldown : float
        --
        + monster_Maly_Szybki()
        + update(dt : float) : void
    }
    class monster_all_rounder {
        + melee_mode : bool
        + melee_threshold : float
        --
        + monster_all_rounder()
        + update(dt : float) : void
    }
    class monster_spawner {
        + max_spawns : int
        + current_spawns : int
        + spawn_interval : float
        + spawn_timer : float
        --
        + monster_spawner()
        + update(dt : float) : void
    }
    class monster_magic {
        + charge_time : float
        + charge_timer : float
        + is_charging : bool
        + post_fire_cooldown : float
        + sidestep_timer : float
        + sidestep_sign : float
        --
        + monster_magic()
        + update(dt : float) : void
    }
    class monster_elite_tank {
        + melee_mode : bool
        + melee_threshold : float
        + heavy_timer : float
        + heavy_cd : float
        --
        + monster_elite_tank()
        + update(dt : float) : void
    }
    class monster_elite_swift {
        + charge_speed : float
        + is_charging : bool
        + charge_timer : float
        + charge_cd : float
        + circle_angle : float
        + circle_radius : float
        --
        + monster_elite_swift()
        + update(dt : float) : void
    }
    class monster_boss {
        + phase_count : int
        --
        + monster_boss()
    }

    class player {
        + sensitivity : float
        + current_weapon_index : int
        + weapons : vector<weapon*>
        + current_weapon : weapon*
        --
        + player(hp : float, shield : float, move_speed : float, sens : float)
        + update(dt : float) : void
        + move(direction : vec3) : void
        + rotate(yaw : float, pitch : float) : void
        + shoot() : void
        + reload() : void
        + switch_weapons(index : int) : void
        + use_grenade() : void
        + take_damage(dmg : float) : void
    }

    monster --|> actor
    player --|> actor
    player "1" o-- "*" weapon : weapons

    monster_basic --|> monster
    monster_ranged --|> monster
    monster_assault --|> monster
    monster_sniper --|> monster
    monster_trapper --|> monster
    monster_Duzy_Gruby --|> monster
    monster_Maly_Szybki --|> monster
    monster_all_rounder --|> monster
    monster_spawner --|> monster
    monster_magic --|> monster
    monster_elite_tank --|> monster
    monster_elite_swift --|> monster
    monster_boss --|> monster

    monster --> actor : target_ptr
}

' ─────────────────────────────────────────────
'  WORLD OBJECTS
' ─────────────────────────────────────────────
package world_object {

    abstract class pickup {
        + position : vec2
        + pickup_radius : float
        + collected : bool
        --
        + pickup(pos : vec2, radius : float)
        + update(dt : float) : void
        + in_range(player_pos : vec2) : bool
        + {abstract} on_pickup(p : player&) : void
    }

    class health_pickup {
        + heal_amount : float
        --
        + health_pickup(pos : vec2, amount : float, radius : float)
        + on_pickup(p : player&) : void
    }

    class armor_pickup {
        + armor_amount : float
        --
        + armor_pickup(pos : vec2, amount : float, radius : float)
        + on_pickup(p : player&) : void
    }

    class ammo_pickup {
        + weapon_id : unsigned int
        + amount : unsigned int
        --
        + ammo_pickup(pos : vec2, wid : unsigned int, amt : unsigned int, radius : float)
        + on_pickup(p : player&) : void
    }

    class weapon_pickup {
        + provided_weapon : weapon*
        --
        + weapon_pickup(pos : vec2, w : weapon*, radius : float)
        + on_pickup(p : player&) : void
    }

    pickup --|> entity
    health_pickup --|> pickup
    armor_pickup --|> pickup
    ammo_pickup --|> pickup
    weapon_pickup --|> pickup

    pickup --> player : on_pickup
    weapon_pickup --> weapon : provided_weapon
}

@enduml
