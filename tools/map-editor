#!/usr/bin/env python3
"""
Doom-style Map Editor  —  pure pygame, no external UI library
Exports: sectors.bin  sidedefs.bin  linedefs.bin  subsectors.bin  nodes.bin  monsters.bin

Binary layouts (packed, little-endian):
  bin_sector    : float fh, float ch, uint32 floor_tex, uint32 ceil_tex, uint8 light
  bin_sidedef   : uint32 facing_sector, uint32 upper_tex, uint32 mid_tex, uint32 lower_tex
  bin_linedef   : int v1x, int v1y, int v2x, int v2y, uint32 front, uint32 back
  bin_subsector : uint32 line_count, uint32 first_line_id
  bin_bsp_node  : float pl_x,pl_y,dir_x,dir_y,
                  f_top,f_bot,f_left,f_right, b_top,b_bot,b_left,b_right,
                  uint32 front_child, uint32 back_child
  bin_monster   : uint32 type, int x, int y, float z
"""

import sys, os, math, struct, json
from dataclasses import dataclass, field

import pygame

