class PropertiesPanel:
    """Floating inspector that shows & edits fields of the selected object."""

    PAD   = 8
    LH    = 20   # line height
    FH    = 22   # field height
    COL_L = 110  # label column width

    def __init__(self, color_picker: ColorPicker):
        self.picker   = color_picker
        self.visible  = False
        self.kind     = None    # 'vertex','linedef','sidedef','sector','subsector'
        self.idx      = None
        self._fields  = []      # list of (label, TextInput | 'color_btn', attr_path)
        self._buttons = []      # (pygame.Rect, label, callback)
        self._rect    = pygame.Rect(PROP_X, PROP_Y, PROP_W, 100)
        self._title   = ""
        self._scroll  = 0
        self._map_ref = None

    # ── public ────────────────────────────────────────────────────────────────

    def inspect(self, kind, idx, map_data):
        self._map_ref = map_data
        self.kind = kind; self.idx = idx
        self.visible = (idx is not None)
        self._rebuild_fields(map_data)

    def clear(self):
        self.visible = False; self.kind=None; self.idx=None
        self._fields=[]; self._buttons=[]

    def commit(self):
        """Write field values back to data."""
        if not self.visible or self._map_ref is None: return
        obj = self._get_obj(self._map_ref)
        if obj is None: return
        for label, widget, attr in self._fields:
            if isinstance(widget, TextInput):
                try:
                    old = getattr(obj, attr)
                    if isinstance(old, int):
                        setattr(obj, attr, int(float(widget.text)))
                    else:
                        setattr(obj, attr, float(widget.text))
                except: pass

    def _get_obj(self, md):
        if self.idx is None: return None
        if self.kind=='vertex':    return md.vertices[self.idx]  if self.idx<len(md.vertices) else None
        if self.kind=='linedef':   return md.linedefs[self.idx]  if self.idx<len(md.linedefs) else None
        if self.kind=='sidedef':   return md.sidedefs[self.idx]  if self.idx<len(md.sidedefs) else None
        if self.kind=='sector':    return md.sectors[self.idx]   if self.idx<len(md.sectors)  else None
        return None

    def _rebuild_fields(self, md):
        self._fields=[]; self._buttons=[]
        obj = self._get_obj(md)

        if self.kind=='vertex' and obj:
            self._title = f"Vertex #{self.idx}"
            self._add_field("x", obj, 'x', True)
            self._add_field("y", obj, 'y', True)

        elif self.kind=='linedef' and obj:
            self._title = f"Linedef #{self.idx}"
            self._add_field("v0 (start)",  obj, 'v0',    True)
            self._add_field("v1 (end)",    obj, 'v1',    True)
            self._add_field("front sidedef", obj, 'front', True)
            self._add_field("back sidedef",  obj, 'back',  True)
            # Quick-jump to sidedefs
            if obj.front != NULL_ID and obj.front < len(md.sidedefs):
                self._add_jump_btn(f"→ Edit front sidedef #{obj.front}", 'sidedef', obj.front)
            if obj.back != NULL_ID and obj.back < len(md.sidedefs):
                self._add_jump_btn(f"→ Edit back sidedef #{obj.back}", 'sidedef', obj.back)

        elif self.kind=='sidedef' and obj:
            self._title = f"Sidedef #{self.idx}"
            self._add_field("facing sector",  obj, 'facing_sector', True)
            self._add_field("upper tex",      obj, 'upper_tex',     True)
            self._add_field("mid tex",        obj, 'mid_tex',       True)
            self._add_field("lower tex",      obj, 'lower_tex',     True)
            if obj.facing_sector < len(md.sectors):
                self._add_jump_btn(f"→ Edit sector #{obj.facing_sector}", 'sector', obj.facing_sector)

        elif self.kind=='sector' and obj:
            self._title = f"Sector #{self.idx}"
            self._add_field("floor height",   obj, 'floor_h',   True)
            self._add_field("ceiling height", obj, 'ceil_h',    True)
            self._add_field("floor tex ID",   obj, 'floor_tex', True)
            self._add_field("ceiling tex ID", obj, 'ceil_tex',  True)
            self._add_field("light (0-255)",  obj, 'light',     True)
            self._add_color_btn("fill color", obj)

        elif self.kind=='subsector':
            self._title = f"Subsector #{self.idx}"
            # subsector color only (subsectors are BSP-derived, not editable per se)
            self._add_subsec_color_btn(md)

        self._recalc_rect()

    def _add_field(self, label, obj, attr, numeric=False):
        val = getattr(obj, attr, 0)
        fi = TextInput(pygame.Rect(0,0,0,self.FH), val, numeric)
        self._fields.append((label, fi, attr))

    def _add_color_btn(self, label, obj):
        self._fields.append((label, 'color_btn_sector', obj))

    def _add_subsec_color_btn(self, md):
        self._fields.append(("fill color", 'color_btn_subsector', None))

    def _add_jump_btn(self, label, kind, idx):
        self._buttons.append((label, kind, idx))

    def _recalc_rect(self):
        n_rows = len(self._fields) + len(self._buttons)
        h = self.PAD*2 + 28 + n_rows*(self.LH+self.PAD) + 36
        self._rect = pygame.Rect(PROP_X, PROP_Y, PROP_W, min(h, SCREEN_H - PROP_Y - 10))
        # layout fields inside rect
        self._layout()

    def _layout(self):
        x = self._rect.x + self.PAD
        y = self._rect.y + self.PAD + 28   # below header
        fw = PROP_W - self.PAD*2 - self.COL_L - 6  # field width
        for i,(label,widget,attr) in enumerate(self._fields):
            if isinstance(widget, TextInput):
                widget.rect = pygame.Rect(x + self.COL_L, y, fw, self.FH)
            y += self.FH + self.PAD

    # ── draw ─────────────────────────────────────────────────────────────────

    def draw(self, surf, font, font_sm, font_hd, md, mx, my):
        if not self.visible: return
        # sync layout positions (in case panel moved)
        self._layout()

        r = self._rect
        # Background
        bg = pygame.Surface((r.width, r.height), pygame.SRCALPHA)
        bg.fill(PROP_BG)
        surf.blit(bg, r.topleft)
        pygame.draw.rect(surf, PROP_BORDER, r, 1, border_radius=6)

        # Header
        hdr = pygame.Rect(r.x, r.y, r.width, 26)
        pygame.draw.rect(surf, PROP_HDR_BG, hdr, border_radius=6)
        pygame.draw.line(surf, PROP_BORDER, (r.x, r.y+26), (r.right, r.y+26))
        title_surf = font_hd.render(self._title, True, (160, 200, 255))
        surf.blit(title_surf, (r.x+8, r.y+6))

        # Close button
        cx = r.right - 20; cy = r.y + 5
        close_r = pygame.Rect(cx, cy, 16, 16)
        hov_close = close_r.collidepoint(mx, my)
        pygame.draw.rect(surf, (140,50,50) if hov_close else (80,40,40), close_r, border_radius=3)
        xt = font_sm.render("✕", True, (220,180,180))
        surf.blit(xt, xt.get_rect(center=close_r.center))

        x0 = r.x + self.PAD
        fw = PROP_W - self.PAD*2 - self.COL_L - 6
        y = r.y + self.PAD + 28

        for label, widget, attr in self._fields:
            lbl_surf = font_sm.render(label, True, TEXT_LABEL)
            surf.blit(lbl_surf, (x0, y + (self.FH - lbl_surf.get_height())//2))

            if isinstance(widget, TextInput):
                widget.draw(surf, font_sm)

            elif widget == 'color_btn_sector':
                # attr is the sector object
                obj = attr
                col = obj.get_color() if obj else (128,128,128)
                btn_r = pygame.Rect(x0 + self.COL_L, y, fw, self.FH)
                pygame.draw.rect(surf, col, btn_r, border_radius=3)
                pygame.draw.rect(surf, (160,180,255) if btn_r.collidepoint(mx,my) else (80,90,130),
                                 btn_r, 1, border_radius=3)
                hex_s = font_sm.render(f"#{col[0]:02X}{col[1]:02X}{col[2]:02X}", True,
                                       (0,0,0) if sum(col)>380 else (230,230,230))
                surf.blit(hex_s, hex_s.get_rect(center=btn_r.center))

            elif widget == 'color_btn_subsector':
                while len(md.subsector_colors) <= self.idx:
                    md.subsector_colors.append(None)
                raw = md.subsector_colors[self.idx]
                col = raw if raw else DEFAULT_SUBSEC_COLORS[self.idx % len(DEFAULT_SUBSEC_COLORS)]
                btn_r = pygame.Rect(x0 + self.COL_L, y, fw, self.FH)
                pygame.draw.rect(surf, col, btn_r, border_radius=3)
                pygame.draw.rect(surf, (160,180,255) if btn_r.collidepoint(mx,my) else (80,90,130),
                                 btn_r, 1, border_radius=3)
                hex_s = font_sm.render(f"#{col[0]:02X}{col[1]:02X}{col[2]:02X}", True,
                                       (0,0,0) if sum(col)>380 else (230,230,230))
                surf.blit(hex_s, hex_s.get_rect(center=btn_r.center))

            y += self.FH + self.PAD

        # Jump buttons
        for label, kind, idx in self._buttons:
            btn_r = pygame.Rect(x0, y, PROP_W - self.PAD*2, 22)
            hov = btn_r.collidepoint(mx,my)
            pygame.draw.rect(surf, BTN_HOV if hov else BTN_NORM, btn_r, border_radius=3)
            pygame.draw.rect(surf, BTN_BORDER, btn_r, 1, border_radius=3)
            bt = font_sm.render(label, True, TEXT_HOT if hov else TEXT_NORM)
            surf.blit(bt, bt.get_rect(center=btn_r.center))
            y += 26

        # Apply button at bottom
        apply_r = pygame.Rect(r.x + self.PAD, r.bottom - 32, PROP_W - self.PAD*2, 26)
        hov_a = apply_r.collidepoint(mx,my)
        pygame.draw.rect(surf, (50,100,180) if hov_a else (35,70,130), apply_r, border_radius=4)
        pygame.draw.rect(surf, ACCENT, apply_r, 1, border_radius=4)
        at = font.render("Apply Changes", True, TEXT_HOT)
        surf.blit(at, at.get_rect(center=apply_r.center))

    def handle(self, event, md, editor_jump):
        """Return True if consumed. editor_jump(kind, idx) navigates selection."""
        if not self.visible: return False

        r = self._rect
        mx, my = (event.pos if hasattr(event,'pos') else pygame.mouse.get_pos())

        # Forward to text fields first
        for label, widget, attr in self._fields:
            if isinstance(widget, TextInput):
                widget.handle(event)

        if event.type == pygame.MOUSEBUTTONDOWN and event.button==1:
            if not r.collidepoint(mx,my): return False

            # Close button
            close_r = pygame.Rect(r.right-20, r.y+5, 16, 16)
            if close_r.collidepoint(mx,my):
                self.clear(); return True

            # Apply button
            apply_r = pygame.Rect(r.x + self.PAD, r.bottom - 32, PROP_W - self.PAD*2, 26)
            if apply_r.collidepoint(mx,my):
                self.commit(); return True

            # Color buttons
            x0 = r.x + self.PAD
            fw = PROP_W - self.PAD*2 - self.COL_L - 6
            y = r.y + self.PAD + 28
            for label, widget, attr in self._fields:
                btn_r = pygame.Rect(x0 + self.COL_L, y, fw, self.FH)
                if widget == 'color_btn_sector' and btn_r.collidepoint(mx,my):
                    obj = attr
                    cur = obj.get_color()
                    def cb(rgb, o=obj): o.color_rgb = rgb
                    self.picker.open(cur, cb, mx-ColorPicker.W//2, my+10)
                    return True
                elif widget == 'color_btn_subsector' and btn_r.collidepoint(mx,my):
                    while len(md.subsector_colors) <= self.idx:
                        md.subsector_colors.append(None)
                    raw = md.subsector_colors[self.idx]
                    cur = raw if raw else DEFAULT_SUBSEC_COLORS[self.idx % len(DEFAULT_SUBSEC_COLORS)]
                    si = self.idx
                    def cb(rgb, i=si): md.subsector_colors[i] = rgb
                    self.picker.open(cur, cb, mx-ColorPicker.W//2, my+10)
                    return True
                y += self.FH + self.PAD

            # Jump buttons
            for label, kind, idx in self._buttons:
                btn_r = pygame.Rect(x0, y, PROP_W - self.PAD*2, 22)
                if btn_r.collidepoint(mx,my):
                    editor_jump(kind, idx); return True
                y += 26

            return True  # consumed (click inside panel)

        return False

    def any_input_active(self):
        return any(isinstance(w,TextInput) and w.active for _,w,_ in self._fields)

    def update(self, dt_ms):
        for _,w,_ in self._fields:
            if isinstance(w, TextInput): w.update(dt_ms)


