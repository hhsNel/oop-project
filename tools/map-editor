class Button:
    def __init__(self, rect, label, accent=False):
        self.rect   = pygame.Rect(rect)
        self.label  = label
        self.accent = accent
        self.hovered= False
        self.pressed= False

    def draw(self, surf, font, font_sm=None):
        if self.pressed:
            bg = BTN_ACT
        elif self.hovered:
            bg = BTN_HOV
        else:
            bg = (50,80,140) if self.accent else BTN_NORM
        pygame.draw.rect(surf, bg,          self.rect, border_radius=4)
        pygame.draw.rect(surf, BTN_BORDER,  self.rect, 1, border_radius=4)
        col = TEXT_HOT if self.hovered or self.accent else TEXT_NORM
        txt = font.render(self.label, True, col)
        surf.blit(txt, txt.get_rect(center=self.rect.center))

    def update(self, mx, my):
        self.hovered = self.rect.collidepoint(mx, my)

    def handle(self, event):
        if event.type == pygame.MOUSEBUTTONDOWN and event.button==1:
            if self.rect.collidepoint(event.pos):
                self.pressed = True
                return True
        if event.type == pygame.MOUSEBUTTONUP:
            self.pressed = False
        return False


class TextInput:
    CURSOR_BLINK = 530

    def __init__(self, rect, value="", numeric=False):
        self.rect    = pygame.Rect(rect)
        self.text    = str(value)
        self.numeric = numeric
        self.active  = False
        self.cursor  = len(self.text)
        self._blink  = 0
        self._show_cur = True

    @property
    def value(self):
        try:    return float(self.text) if '.' in self.text else int(self.text)
        except: return 0

    def set(self, v):
        self.text   = str(v)
        self.cursor = len(self.text)

    def draw(self, surf, font, font_sm=None):
        bg  = FIELD_ACT  if self.active else FIELD_BG
        bor = FIELD_ACBR if self.active else FIELD_BOR
        pygame.draw.rect(surf, bg,  self.rect, border_radius=3)
        pygame.draw.rect(surf, bor, self.rect, 1, border_radius=3)
        display = self.text if self.text else ""
        txt = font.render(display, True, TEXT_NORM)
        clip = self.rect.inflate(-8, -4)
        surf.set_clip(clip)
        ty = self.rect.centery - txt.get_height()//2
        cx_px = font.size(self.text[:self.cursor])[0]
        ox = min(0, clip.width - cx_px - 4)
        surf.blit(txt, (clip.x + ox, ty))
        if self.active and self._show_cur:
            cx = clip.x + ox + cx_px
            pygame.draw.line(surf, ACCENT, (cx, ty+2), (cx, ty+txt.get_height()-2))
        surf.set_clip(None)

    def update(self, dt_ms):
        self._blink += dt_ms
        if self._blink >= self.CURSOR_BLINK:
            self._blink = 0; self._show_cur = not self._show_cur

    def handle(self, event):
        if event.type == pygame.MOUSEBUTTONDOWN and event.button==1:
            self.active = self.rect.collidepoint(event.pos)
            if self.active: self.cursor = len(self.text)
        if not self.active: return False
        if event.type == pygame.KEYDOWN:
            k = event.key
            if k == pygame.K_BACKSPACE:
                if self.cursor > 0:
                    self.text = self.text[:self.cursor-1] + self.text[self.cursor:]
                    self.cursor -= 1
            elif k == pygame.K_DELETE:
                self.text = self.text[:self.cursor] + self.text[self.cursor+1:]
            elif k == pygame.K_LEFT:
                self.cursor = max(0, self.cursor-1)
            elif k == pygame.K_RIGHT:
                self.cursor = min(len(self.text), self.cursor+1)
            elif k == pygame.K_HOME: self.cursor = 0
            elif k == pygame.K_END:  self.cursor = len(self.text)
            elif k in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_TAB):
                self.active = False
            else:
                ch = event.unicode
                if ch and (not self.numeric or ch in '0123456789.-'):
                    self.text = self.text[:self.cursor] + ch + self.text[self.cursor:]
                    self.cursor += 1
            self._show_cur = True; self._blink = 0
        return False


class Label:
    def __init__(self, rect, text, color=TEXT_LABEL, small=False):
        self.rect  = pygame.Rect(rect)
        self.text  = text
        self.color = color
        self.small = small

    def draw(self, surf, font, font_sm):
        f = font_sm if self.small else font
        txt = f.render(self.text, True, self.color)
        surf.blit(txt, (self.rect.x, self.rect.centery - txt.get_height()//2))


class Separator:
    def __init__(self, y, x0, x1):
        self.y=y; self.x0=x0; self.x1=x1
    def draw(self, surf, *_):
        pygame.draw.line(surf, PANEL_LINE, (self.x0,self.y),(self.x1,self.y))


class ToolButton(Button):
    def __init__(self, rect, label, tool_id):
        super().__init__(rect, label)
        self.tool_id = tool_id
        self.active  = False

    def draw(self, surf, font, font_sm=None):
        if self.active:
            bg = BTN_ACT
        elif self.hovered:
            bg = BTN_HOV
        else:
            bg = BTN_NORM
        pygame.draw.rect(surf, bg,         self.rect, border_radius=4)
        col_b = ACCENT if self.active else BTN_BORDER
        pygame.draw.rect(surf, col_b,      self.rect, 1 if not self.active else 2,
                         border_radius=4)
        col = TEXT_HOT if self.active or self.hovered else TEXT_NORM
        txt = font.render(self.label, True, col)
        surf.blit(txt, txt.get_rect(center=self.rect.center))


