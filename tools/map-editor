        surf.blit(txt,(CANVAS_W+10,y-6))
        y+=14
        for k,v in stats:
            kt=self.font_sm.render(f"{k}:",True,TEXT_DIM)
            vt=self.font_sm.render(str(v),True,TEXT_NORM)
            surf.blit(kt,(CANVAS_W+12,y))
            surf.blit(vt,(SCREEN_W-12-vt.get_width(),y))
            y+=16

    def _draw_statusbar(self, surf):
        pygame.draw.rect(surf,(12,14,22),(0,CANVAS_H-22,CANVAS_W,22))
        pygame.draw.line(surf,(40,45,65),(0,CANVAS_H-22),(CANVAS_W,CANVAS_H-22),1)
        tool_labels = {TOOL_VERTEX:"✦ VERTEX",TOOL_LINE:"╱ LINE",
                       TOOL_SECTOR:"▣ PAINT",TOOL_MONSTER:"☠ MONSTER",
                       TOOL_PICKUP:"♦ PICKUP",TOOL_SELECT:"⊹ SELECT",
                       TOOL_DELETE:"✕ DELETE"}
        badge=self.font_hd.render(f" {tool_labels[self.tool]} ",True,(20,22,32))
        bs=badge.get_rect(); bs.inflate_ip(8,4)
        bs.topleft=(6,CANVAS_H-20)
        pygame.draw.rect(surf,ACCENT,bs,border_radius=3)
        surf.blit(badge,(bs.x+4,bs.y+2))
        st=self.font_sm.render(self.status,True,TEXT_NORM)
        surf.blit(st,(bs.right+10,CANVAS_H-16))

    def _draw_coord(self, surf, mx, my):
        if mx>=CANVAS_W: return
        wx,wy=self.s2w(mx,my); swx,swy=self.snap(wx,wy)
        coord=self.font_sm.render(f"({int(swx)},{int(swy)})",True,TEXT_DIM)
        surf.blit(coord,(mx+12,my-16))

    # ── Mouse on canvas ────────────────────────────────────────────────────────

    def _canvas_mouse(self, event, mx, my):
        wx,wy=self.s2w(mx,my); swx,swy=self.snap(wx,wy)

        if event.type==pygame.MOUSEBUTTONDOWN:
            if event.button==2:
                self.panning=True; self.pan_start=(mx,my)
                self.pan_cam=(self.cam_x,self.cam_y)
            elif event.button==1:
                if not self._any_input_active():
                    self._lmb(swx,swy,wx,wy)

        elif event.type==pygame.MOUSEBUTTONUP:
            if event.button==2: self.panning=False

        elif event.type==pygame.MOUSEMOTION:
            if self.panning:
                dx=(mx-self.pan_start[0])/self.zoom
                dy=(my-self.pan_start[1])/self.zoom
                self.cam_x=self.pan_cam[0]-dx
                self.cam_y=self.pan_cam[1]+dy
            else:
                self.hov_vert=self.near_vert(wx,wy,14)
                self.hov_line=self.near_line(wx,wy,8)
                # hover sector / subsector
                self.hov_sector = self._find_sector_at(wx,wy) if self.tool==TOOL_SELECT else None
                self.hov_subsector = (self._find_subsector_at(wx,wy)
                                      if self.tool==TOOL_SELECT and self.show_bsp else None)
                self.hov_monster=self.near_monster(wx,wy,14)
                self.hov_pickup=self.near_pickup(wx,wy,14)

        elif event.type==pygame.MOUSEWHEEL:
            fac=1.15 if event.y>0 else 1/1.15
            old_z=self.zoom
            self.zoom=max(0.04,min(20.0,self.zoom*fac))
            self.cam_x+=(wx-self.cam_x)*(1-old_z/self.zoom)
            self.cam_y+=(wy-self.cam_y)*(1-old_z/self.zoom)

    def _lmb(self, swx, swy, wx, wy):
        t=self.tool

        if t==TOOL_VERTEX:
            vi=self.near_vert(wx,wy,14)
            if vi is None:
                self.map.vertices.append(Vertex(swx,swy))
                self.status=f"Vertex added at ({int(swx)},{int(swy)})"
            self._rebuild_bsp()

        elif t==TOOL_LINE:
            vi=self.near_vert(wx,wy,14)
            if vi is None:
                self.map.vertices.append(Vertex(swx,swy)); vi=len(self.map.vertices)-1
            if self.line_start is None:
                self.line_start=vi
                self.status=f"Line start: vertex #{vi} — click to place end"
            else:
                if vi!=self.line_start:
                    self._ensure_sector()
                    sd=self._get_sidedef(self.cur_sector)
                    self.map.linedefs.append(Linedef(self.line_start,vi,sd,NULL_ID))
                    self.status=f"Linedef #{len(self.map.linedefs)-1} added  (sector {self.cur_sector})"
                self.line_start=vi
                self._rebuild_bsp()

        elif t==TOOL_SECTOR:
            li=self.near_line(wx,wy,12)
            if li is not None:
                self._ensure_sector(); sd=self._get_sidedef(self.cur_sector)
                l=self.map.linedefs[li]
                side=_seg_side(self.map.vertices[l.v0].x,self.map.vertices[l.v0].y,
                               self.map.vertices[l.v1].x,self.map.vertices[l.v1].y,wx,wy)
                if side>=0: self.map.linedefs[li]=Linedef(l.v0,l.v1,sd,l.back)
                else:       self.map.linedefs[li]=Linedef(l.v0,l.v1,l.front,sd)
                self.status=f"Painted sector {self.cur_sector} on line #{li}"
                self._rebuild_bsp()

        elif t==TOOL_SELECT:
            vi=self.near_vert(wx,wy,14); li=self.near_line(wx,wy,8)
            mods = pygame.key.get_mods()
            shift = mods & pygame.KMOD_SHIFT

            if not shift:
                self.sel_verts=[]; self.sel_lines=[]
                self.sel_sector=None; self.sel_subsector=None

            if vi is not None:
                if vi in self.sel_verts: self.sel_verts.remove(vi)
                else: self.sel_verts.append(vi)
                v=self.map.vertices[vi]
                self.status=f"Vertex #{vi} at ({int(v.x)},{int(v.y)})"
                self.props.inspect('vertex', vi, self.map)

            elif li is not None:
                if li in self.sel_lines: self.sel_lines.remove(li)
                else: self.sel_lines.append(li)
                l=self.map.linedefs[li]
                bs="wall" if l.back==NULL_ID else str(l.back)
                self.status=f"Line #{li}  v{l.v0}→v{l.v1}  front={l.front} back={bs}"
                self.props.inspect('linedef', li, self.map)

            else:
                # Try subsector first (only if BSP visible), then sector
                if self.show_bsp:
                    ssi = self._find_subsector_at(wx,wy)
                    if ssi is not None:
                        self.sel_subsector = ssi
                        self.status=f"Subsector #{ssi}  ({len(self.bsp_subs[ssi])} lines)"
                        self.props.inspect('subsector', ssi, self.map)
                        return

                si = self._find_sector_at(wx,wy)
                if si is not None:
                    self.sel_sector = si
                    s = self.map.sectors[si]
                    self.status=f"Sector #{si}  floor={s.floor_h} ceil={s.ceil_h} light={s.light}"
                    self.props.inspect('sector', si, self.map)
                else:
                    self.props.clear()

        elif t==TOOL_MONSTER:
            mt=max(0,min(len(MONSTER_NAMES)-1,self._int(self.fi_monster_type,2)))
            mz=self._flt(self.fi_monster_z,0.0)
            self.map.monsters.append(MonsterSpawn(swx,swy,mt,mz))
            name=MONSTER_NAMES[mt]
            self.status=f"Monster '{name}' placed at ({int(swx)},{int(swy)})"

        elif t==TOOL_PICKUP:
            pt=max(0,min(len(PICKUP_NAMES)-1,self._int(self.fi_pickup_type,0)))
            if pt==3:
                pst=max(0,min(len(AMMO_SUBTYPE_NAMES)-1,self._int(self.fi_pickup_subtype,0)))
            elif pt==2:
                pst=max(0,min(len(WEAPON_SUBTYPE_NAMES)-1,self._int(self.fi_pickup_subtype,0)))
            else:
                pst=0
            pz=self._flt(self.fi_pickup_z,0.0)
            self.map.pickups.append(PickupSpawn(swx,swy,pt,pst,pz))
            name=PICKUP_NAMES[pt]
            if pt==2: name+=f"({WEAPON_SUBTYPE_NAMES[pst]})"
            elif pt==3: name+=f"({AMMO_SUBTYPE_NAMES[pst]})"
            self.status=f"Pickup '{name}' placed at ({int(swx)},{int(swy)})"

        elif t==TOOL_MONSTER:
            mt=max(0,min(len(MONSTER_NAMES)-1,self._int(self.fi_monster_type,2)))
            mz=self._flt(self.fi_monster_z,0.0)
            self.map.monsters.append(MonsterSpawn(swx,swy,mt,mz))
            name=MONSTER_NAMES[mt]
            self.status=f"Monster '{name}' placed at ({int(swx)},{int(swy)})"

        elif t==TOOL_DELETE:
            mi=self.near_monster(wx,wy,14)
            pi=self.near_pickup(wx,wy,14)
            vi=self.near_vert(wx,wy,14); li=self.near_line(wx,wy,8)
            if mi is not None:
                self.map.monsters.pop(mi)
                self.status=f"Deleted monster #{mi}"
            elif pi is not None:
                self.map.pickups.pop(pi)
                self.status=f"Deleted pickup #{pi}"
            elif vi is not None:
                self.map.linedefs=[l for l in self.map.linedefs if l.v0!=vi and l.v1!=vi]
                self.map.vertices.pop(vi)
                for i,l in enumerate(self.map.linedefs):
                    v0=l.v0 if l.v0<vi else l.v0-1
                    v1=l.v1 if l.v1<vi else l.v1-1
                    self.map.linedefs[i]=Linedef(v0,v1,l.front,l.back)
                self.status=f"Deleted vertex #{vi}"
            elif li is not None:
                self.map.linedefs.pop(li)
                self.status=f"Deleted linedef #{li}"
            self.sel_verts=[]; self.sel_lines=[]
            self._rebuild_bsp()

    # ── Properties jump callback ───────────────────────────────────────────────

    def _props_jump(self, kind, idx):
        self.props.inspect(kind, idx, self.map)

    # ── Button actions ─────────────────────────────────────────────────────────

    def _btn_action(self, btn):
        if btn==self.btn_new_sec:
            ci=len(self.map.sectors)%len(DEFAULT_SECTOR_COLORS)
            self.map.sectors.append(Sector(color_idx=ci))
            self.cur_sector=len(self.map.sectors)-1
            self.fi_sec_idx.set(self.cur_sector)
            self._sync_sector_fields()
            self.status=f"Created sector #{self.cur_sector}"

        elif btn==self.btn_apply:
            idx=self._int(self.fi_sec_idx,0)
            while len(self.map.sectors)<=idx:
                ci=len(self.map.sectors)%len(DEFAULT_SECTOR_COLORS)
                self.map.sectors.append(Sector(color_idx=ci))
            self.cur_sector=idx
            s=self.map.sectors[idx]
            s.floor_h  =self._flt(self.fi_floor_h,0.0)
            s.ceil_h   =self._flt(self.fi_ceil_h,128.0)
            s.floor_tex=self._int(self.fi_floor_tex,0)
            s.ceil_tex =self._int(self.fi_ceil_tex,0)
            s.light    =max(0,min(255,self._int(self.fi_light,200)))
            self.status=f"Sector #{idx} updated"

        elif btn==self.btn_bsp:
            self.show_bsp=not self.show_bsp
            self.btn_bsp.label="Hide BSP Overlay" if self.show_bsp else "Show BSP Overlay"
            self._rebuild_bsp()

        elif btn==self.btn_export:
            try:
                ns,nl,nb,nss,nm,np=export_bin(self.map,"map_output")
                self.status=f"Exported → map_output/  ({ns} sectors, {nl} lines, {nb} nodes, {nss} subs, {nm} monsters, {np} pickups)"
            except Exception as e:
                self.status=f"Export error: {e}"

        elif btn==self.btn_save:
            try:
                save_json(self.map,"map.json")
                self.status="Saved to map.json"
            except Exception as e:
                self.status=f"Save error: {e}"

        elif btn==self.btn_load:
            try:
                self.map=load_json("map.json")
                self._rebuild_bsp()
                self.status=f"Loaded map.json — {len(self.map.linedefs)} lines"
            except Exception as e:
                self.status=f"Load error: {e}"

        elif btn==self.btn_clear:
            self.map.clear(); self.line_start=None
            self.sel_verts=[]; self.sel_lines=[]
            self.sel_sector=None; self.sel_subsector=None
            self.props.clear()
            self._rebuild_bsp(); self.status="Map cleared."

        elif isinstance(btn, ToolButton):
            for tb in self._tool_btns: tb.active=False
            btn.active=True; self.tool=btn.tool_id
            if btn.tool_id!=TOOL_LINE: self.line_start=None

    # ── Main loop ──────────────────────────────────────────────────────────────

    def run(self):
        mx=my=0
        while self.running:
            dt_ms=self.clock.tick(60)

            for event in pygame.event.get():
                if event.type==pygame.QUIT: self.running=False

                if self.help.handle(event): continue

                # Color picker gets priority
                if self.color_picker.handle(event): continue

                # Properties panel
                if self.props.handle(event, self.map, self._props_jump): continue

                for w in self._all_inputs():
                    w.handle(event)

                for w in self.widgets:
                    if isinstance(w,(Button,ToolButton)) and w.handle(event):
                        self._btn_action(w)

                if event.type==pygame.KEYDOWN and not self._any_input_active():
                    k=event.key
                    if   k==pygame.K_ESCAPE:
                        self.line_start=None; self.sel_verts=[]; self.sel_lines=[]
                        self.sel_sector=None; self.sel_subsector=None
                        self.props.clear()
                    elif k in (pygame.K_F1, pygame.K_QUESTION, pygame.K_SLASH): self.help.toggle()
                    elif k==pygame.K_v: self._btn_action(self.tb_vertex)
                    elif k==pygame.K_l: self._btn_action(self.tb_line)
                    elif k==pygame.K_s: self._btn_action(self.tb_sector)
                    elif k==pygame.K_m: self._btn_action(self.tb_monster)
                    elif k==pygame.K_p: self._btn_action(self.tb_pickup)
                    elif k==pygame.K_e: self._btn_action(self.tb_select)
                    elif k==pygame.K_d: self._btn_action(self.tb_delete)
                    elif k==pygame.K_b: self._btn_action(self.btn_bsp)
                    elif k==pygame.K_HOME: self.cam_x=0; self.cam_y=0; self.zoom=1.0
                    elif k==pygame.K_F5:
                        try:
                            ns,nl,nb,nss,nm,np=export_bin(self.map,"map_output")
                            self.status=f"[F5] Exported: {ns} sec, {nl} lines, {nb} nodes, {nss} subs, {nm} monsters, {np} pickups"
                        except Exception as ex:
                            self.status=f"Export error: {ex}"
                    elif k==pygame.K_DELETE and self.sel_lines:
                        for li in sorted(self.sel_lines,reverse=True):
                            if li<len(self.map.linedefs): self.map.linedefs.pop(li)
                        self.sel_lines=[]; self._rebuild_bsp()

                if event.type in (pygame.MOUSEBUTTONDOWN,pygame.MOUSEBUTTONUP,
                                  pygame.MOUSEMOTION,pygame.MOUSEWHEEL):
                    if event.type==pygame.MOUSEMOTION: mx,my=event.pos
                    elif hasattr(event,'pos'): mx,my=event.pos
                    if mx<CANVAS_W:
                        self._canvas_mouse(event,mx,my)
                    elif event.type==pygame.MOUSEMOTION:
                        self.hov_vert=None; self.hov_line=None

                for w in self.widgets:
                    if isinstance(w,(Button,ToolButton)): w.update(mx,my)

            for w in self._all_inputs(): w.update(dt_ms)
            self.props.update(dt_ms)

            try:
                idx=int(float(self.fi_sec_idx.text))
                if not self.fi_sec_idx.active and idx!=self.cur_sector:
                    self.cur_sector=idx; self._sync_sector_fields()
            except: pass

            # ── Render ─────────────────────────────────────────────────────────
            self.screen.fill(BG,(0,0,CANVAS_W,CANVAS_H))
            self._draw_grid(self.screen)
            self._draw_sector_fills(self.screen)
            if self.show_bsp: self._draw_bsp(self.screen)
            self._draw_lines(self.screen)
            if self.tool==TOOL_LINE: self._draw_preview(self.screen,mx,my)
            self._draw_verts(self.screen)
            self._draw_monsters(self.screen)
            self._draw_pickups(self.screen)
            self._draw_statusbar(self.screen)
            if mx<CANVAS_W: self._draw_coord(self.screen,mx,my)
            self._draw_panel(self.screen)
            # Properties overlay (on top of canvas)
            self.props.draw(self.screen, self.font, self.font_sm, self.font_hd,
                            self.map, mx, my)
            # Color picker (topmost)
            self.color_picker.draw(self.screen, self.font)
            self.help.draw(self.screen, self.font, self.font_hd)
            pygame.display.flip()

        pygame.quit()

