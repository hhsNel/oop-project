# ══════════════════════════════════════════════════════════════════════════════
#  Data model
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class Vertex:
    x: float; y: float

@dataclass
class Sector:
    floor_h:   float = 0.0
    ceil_h:    float = 128.0
    floor_tex: int   = 0
    ceil_tex:  int   = 0
    light:     int   = 200
    color_idx: int   = 0

@dataclass
class Sidedef:
    facing_sector: int
    upper_tex: int = 0
    mid_tex:   int = 1
    lower_tex: int = 0

@dataclass
class Linedef:
    v0: int; v1: int
    front: int = NULL_ID
    back:  int = NULL_ID

@dataclass
class MonsterSpawn:
    x: float; y: float
    monster_type: int = 2   # default: basic
    z: float = 0.0

@dataclass
class MapData:
    vertices: list = field(default_factory=list)
    sectors:  list = field(default_factory=list)
    sidedefs: list = field(default_factory=list)
    linedefs: list = field(default_factory=list)
    monsters: list = field(default_factory=list)

    def clear(self):
        self.vertices.clear(); self.sectors.clear()
        self.sidedefs.clear(); self.linedefs.clear()
        self.monsters.clear()

# ══════════════════════════════════════════════════════════════════════════════
#  BSP builder
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class BSPNode:
    pl_x:float; pl_y:float; dir_x:float; dir_y:float
    f_top:float; f_bot:float; f_left:float; f_right:float
    b_top:float; b_bot:float; b_left:float; b_right:float
    front_child:int; back_child:int

def _seg_side(ax,ay,bx,by,px,py):
    dx,dy = bx-ax, by-ay
    return dx*(py-ay) - dy*(px-ax)

def _build_bsp(line_indices, all_lines, verts, nodes, subsectors, depth=0):
    if not line_indices:
        si = len(subsectors); subsectors.append([]); return si | LEAF_FLAG

    if len(line_indices) <= 3 or depth > 24:
        si = len(subsectors); subsectors.append(list(line_indices)); return si | LEAF_FLAG

    splitter = None
    for idx in line_indices:
        l = all_lines[idx]
        if abs(verts[l.v1].x-verts[l.v0].x)<1 or abs(verts[l.v1].y-verts[l.v0].y)<1:
            splitter = idx; break
    if splitter is None: splitter = line_indices[0]

    sl = all_lines[splitter]
    ax,ay = verts[sl.v0].x, verts[sl.v0].y
    bx,by = verts[sl.v1].x, verts[sl.v1].y
    dx,dy = bx-ax, by-ay
    ln = math.hypot(dx,dy)
    if ln < 1e-6:
        si = len(subsectors); subsectors.append(list(line_indices)); return si | LEAF_FLAG
    ndx,ndy = dx/ln, dy/ln

    EPS = 1e-4
    front_idx, back_idx = [], []
    for idx in line_indices:
        l = all_lines[idx]
        s0 = _seg_side(ax,ay,bx,by, verts[l.v0].x,verts[l.v0].y)
        s1 = _seg_side(ax,ay,bx,by, verts[l.v1].x,verts[l.v1].y)
        if s0 >= -EPS and s1 >= -EPS:
            front_idx.append(idx)
        elif s0 <= EPS and s1 <= EPS:
            back_idx.append(idx)
        else:
            lx = verts[l.v1].x-verts[l.v0].x; ly = verts[l.v1].y-verts[l.v0].y
            denom = dx*ly - dy*lx
            if abs(denom) < 1e-9: front_idx.append(idx); continue
            t = (dx*(verts[l.v0].y-ay) - dy*(verts[l.v0].x-ax)) / denom
            ix = verts[l.v0].x + t*lx; iy = verts[l.v0].y + t*ly
            mi = len(verts); verts.append(Vertex(ix,iy))
            nf = Linedef(l.v0 if s0>=0 else mi, mi if s0>=0 else l.v1, l.front, l.back)
            nb = Linedef(l.v0 if s0< 0 else mi, mi if s0< 0 else l.v1, l.front, l.back)
            nfi = len(all_lines); all_lines.append(nf); front_idx.append(nfi)
            nbi = len(all_lines); all_lines.append(nb); back_idx.append(nbi)

    if not front_idx:
        si = len(subsectors); subsectors.append(list(back_idx)); return si | LEAF_FLAG
    if not back_idx:
        si = len(subsectors); subsectors.append(list(front_idx)); return si | LEAF_FLAG

    def bb(idxs):
        if not idxs: return 0,0,0,0
        xs=[verts[all_lines[i].v0].x for i in idxs]+[verts[all_lines[i].v1].x for i in idxs]
        ys=[verts[all_lines[i].v0].y for i in idxs]+[verts[all_lines[i].v1].y for i in idxs]
        return max(ys),min(ys),min(xs),max(xs)

    fb=bb(front_idx); bbb=bb(back_idx)
    ni = len(nodes); nodes.append(None)
    fc = _build_bsp(front_idx, all_lines, verts, nodes, subsectors, depth+1)
    bc = _build_bsp(back_idx,  all_lines, verts, nodes, subsectors, depth+1)
    nodes[ni] = BSPNode(ax,ay,ndx,ndy, fb[0],fb[1],fb[2],fb[3],
                        bbb[0],bbb[1],bbb[2],bbb[3], fc, bc)
    return ni

def build_bsp(md: MapData):
    verts = [Vertex(v.x,v.y) for v in md.vertices]
    lines = [Linedef(l.v0,l.v1,l.front,l.back) for l in md.linedefs]
    nodes=[]; subs=[]
    if lines:
        _build_bsp(list(range(len(lines))), lines, verts, nodes, subs)
    return nodes, subs, lines, verts

# ══════════════════════════════════════════════════════════════════════════════
#  Binary export
# ══════════════════════════════════════════════════════════════════════════════

def export_bin(md: MapData, out_dir: str):
    os.makedirs(out_dir, exist_ok=True)
    with open(os.path.join(out_dir,"sectors.bin"),"wb") as f:
        for s in md.sectors:
            f.write(struct.pack("<ffIIB", s.floor_h,s.ceil_h,s.floor_tex,s.ceil_tex,s.light))
    with open(os.path.join(out_dir,"sidedefs.bin"),"wb") as f:
        for sd in md.sidedefs:
            f.write(struct.pack("<IIII", sd.facing_sector,sd.upper_tex,sd.mid_tex,sd.lower_tex))
    nodes,subs,wlines,wverts = build_bsp(md)
    flat=[]; sub_recs=[]
    for sub in subs:
        first=len(flat)
        for li in sub: flat.append(wlines[li])
        sub_recs.append((len(sub),first))
    with open(os.path.join(out_dir,"linedefs.bin"),"wb") as f:
        for l in flat:
            v0=wverts[l.v0]; v1=wverts[l.v1]
            f.write(struct.pack("<iiiiII", int(v0.x),int(v0.y),int(v1.x),int(v1.y),
                                l.front, l.back if l.back!=NULL_ID else NULL_ID))
    with open(os.path.join(out_dir,"subsectors.bin"),"wb") as f:
        for cnt,first in sub_recs:
            f.write(struct.pack("<II",cnt,first))
    with open(os.path.join(out_dir,"nodes.bin"),"wb") as f:
        for n in nodes:
            if n is None: continue
            f.write(struct.pack("<ffffffffffff II",
                n.pl_x,n.pl_y,n.dir_x,n.dir_y,
                n.f_top,n.f_bot,n.f_left,n.f_right,
                n.b_top,n.b_bot,n.b_left,n.b_right,
                n.front_child,n.back_child))
    with open(os.path.join(out_dir,"monsters.bin"),"wb") as f:
        for m in md.monsters:
            f.write(struct.pack("<Iiif", m.monster_type, int(m.x), int(m.y), m.z))
    return len(md.sectors),len(md.linedefs),len(nodes),len(sub_recs),len(md.monsters)

# ══════════════════════════════════════════════════════════════════════════════
#  JSON save / load
# ══════════════════════════════════════════════════════════════════════════════

def save_json(md,path):
    d={"vertices":[{"x":v.x,"y":v.y} for v in md.vertices],
       "sectors":[{"floor_h":s.floor_h,"ceil_h":s.ceil_h,"floor_tex":s.floor_tex,
                   "ceil_tex":s.ceil_tex,"light":s.light,"color_idx":s.color_idx}
                  for s in md.sectors],
       "sidedefs":[{"facing_sector":sd.facing_sector,"upper_tex":sd.upper_tex,
                    "mid_tex":sd.mid_tex,"lower_tex":sd.lower_tex} for sd in md.sidedefs],
       "linedefs":[{"v0":l.v0,"v1":l.v1,"front":l.front,"back":l.back}
                   for l in md.linedefs],
       "monsters":[{"x":m.x,"y":m.y,"monster_type":m.monster_type,"z":m.z}
                   for m in md.monsters]}
    with open(path,"w") as f: json.dump(d,f,indent=2)

def load_json(path):
    with open(path) as f: d=json.load(f)
    md=MapData()
    md.vertices=[Vertex(**v) for v in d["vertices"]]
    md.sectors=[Sector(**s) for s in d["sectors"]]
    md.sidedefs=[Sidedef(**sd) for sd in d["sidedefs"]]
    md.linedefs=[Linedef(**l) for l in d["linedefs"]]
    md.monsters=[MonsterSpawn(**m) for m in d.get("monsters",[])]
    return md

