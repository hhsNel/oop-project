class HelpOverlay:
    def __init__(self):
        self.visible = False

    def toggle(self):
        self.visible = not self.visible

    def handle(self, event):
        if not self.visible: return False
        if event.type == pygame.KEYDOWN and event.key in (
                pygame.K_ESCAPE, pygame.K_F1, pygame.K_QUESTION, pygame.K_SLASH):
            self.visible = False; return True
        if event.type == pygame.MOUSEBUTTONDOWN:
            self.visible = False; return True
        return True

    def draw(self, surf, font, font_hd):
        if not self.visible: return
        sw, sh = surf.get_size()
        PAD = 40
        dim = pygame.Surface((sw, sh), pygame.SRCALPHA)
        dim.fill((0, 0, 0, 200))
        surf.blit(dim, (0, 0))
        box = pygame.Rect(PAD, PAD, sw - PAD*2, sh - PAD*2)
        pygame.draw.rect(surf, (22, 25, 40), box, border_radius=8)
        pygame.draw.rect(surf, (70, 90, 150), box, 2, border_radius=8)
        title = font_hd.render(
            "MAP EDITOR  —  REFERENCE  (press Esc, F1, or click to close)",
            True, (160, 190, 255))
        surf.blit(title, (PAD + 20, PAD + 14))
        pygame.draw.line(surf, (50, 60, 100),
                         (PAD + 16, PAD + 38), (PAD + box.width - 16, PAD + 38))
        lh = font.get_linesize()
        col_w = (box.width - 40) // 2
        positions = [PAD + 16, PAD + 16 + col_w + 8]
        col = 0; cy = PAD + 50
        for section, lines in HELP_SECTIONS:
            needed = (lh + 4) + len(lines) * lh + 14
            if cy + needed > PAD + box.height - 16 and col == 0:
                col = 1; cy = PAD + 50
            x = positions[col]
            hdr = font_hd.render(section, True, (100, 170, 255))
            surf.blit(hdr, (x, cy)); cy += lh + 4
            for ln in lines:
                txt = font.render(ln, True, (190, 200, 220))
                surf.blit(txt, (x + 8, cy)); cy += lh
            cy += 14


