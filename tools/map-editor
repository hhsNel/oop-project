class ColorPicker:
    """Simple HSV color picker popup."""
    W, H = 260, 300

    def __init__(self):
        self.visible   = False
        self.callback  = None   # called with (r,g,b) when confirmed
        self.hue       = 0.0    # 0..1
        self.sat       = 0.8
        self.val       = 0.8
        self._drag_sv  = False
        self._drag_hue = False
        self.sx = 100; self.sy = 100

    def open(self, rgb, callback, sx=None, sy=None):
        r,g,b = rgb
        # convert to hsv
        r,g,b = r/255,g/255,b/255
        mx=max(r,g,b); mn=min(r,g,b); diff=mx-mn
        if diff==0: h=0
        elif mx==r: h=(60*((g-b)/diff))%360
        elif mx==g: h=60*((b-r)/diff)+120
        else:       h=60*((r-g)/diff)+240
        self.hue = h/360
        self.sat = diff/mx if mx>0 else 0
        self.val = mx
        self.visible  = True
        self.callback = callback
        if sx: self.sx = max(0, min(sx, CANVAS_W - self.W - 10))
        if sy: self.sy = max(0, min(sy, SCREEN_H - self.H - 10))

    def _hsv_to_rgb(self, h, s, v):
        h=h*360
        c=v*s; x=c*(1-abs((h/60)%2-1)); m=v-c
        if   h<60:  r,g,b=c,x,0
        elif h<120: r,g,b=x,c,0
        elif h<180: r,g,b=0,c,x
        elif h<240: r,g,b=0,x,c
        elif h<300: r,g,b=x,0,c
        else:       r,g,b=c,0,x
        return int((r+m)*255),int((g+m)*255),int((b+m)*255)

    def current_rgb(self):
        return self._hsv_to_rgb(self.hue, self.sat, self.val)

    def _sv_rect(self):
        return pygame.Rect(self.sx+10, self.sy+40, self.W-20, 180)

    def _hue_rect(self):
        return pygame.Rect(self.sx+10, self.sy+230, self.W-20, 20)

    def draw(self, surf, font):
        if not self.visible: return

        # Background
        box = pygame.Rect(self.sx, self.sy, self.W, self.H)
        bg_surf = pygame.Surface((self.W, self.H), pygame.SRCALPHA)
        bg_surf.fill((18, 20, 35, 245))
        surf.blit(bg_surf, (self.sx, self.sy))
        pygame.draw.rect(surf, (80, 100, 180), box, 2, border_radius=6)

        # Title
        title = font.render("Pick Color", True, (200, 210, 255))
        surf.blit(title, (self.sx+10, self.sy+10))

        # SV square
        svr = self._sv_rect()
        # Draw gradient: for perf, draw columns
        for ix in range(svr.width):
            s = ix / svr.width
            for iy in range(svr.height):
                v = 1.0 - iy / svr.height
                r,g,b = self._hsv_to_rgb(self.hue, s, v)
                surf.set_at((svr.x+ix, svr.y+iy), (r,g,b))
        # SV cursor
        cx = svr.x + int(self.sat * svr.width)
        cy = svr.y + int((1-self.val) * svr.height)
        pygame.draw.circle(surf, (255,255,255), (cx,cy), 6, 2)
        pygame.draw.circle(surf, (0,0,0),       (cx,cy), 4, 1)
        pygame.draw.rect(surf, (80,100,160), svr, 1)

        # Hue bar
        hr = self._hue_rect()
        for ix in range(hr.width):
            r,g,b = self._hsv_to_rgb(ix/hr.width, 1.0, 1.0)
            pygame.draw.line(surf, (r,g,b), (hr.x+ix, hr.y), (hr.x+ix, hr.y+hr.height))
        hx = hr.x + int(self.hue * hr.width)
        pygame.draw.rect(surf, (255,255,255), (hx-2, hr.y-2, 4, hr.height+4), 2)
        pygame.draw.rect(surf, (80,100,160), hr, 1)

        # Preview swatch
        pr,pg,pb = self.current_rgb()
        swatch = pygame.Rect(self.sx+10, self.sy+260, 60, 28)
        pygame.draw.rect(surf, (pr,pg,pb), swatch, border_radius=4)
        pygame.draw.rect(surf, (100,120,180), swatch, 1, border_radius=4)
        rgb_txt = font.render(f"#{pr:02X}{pg:02X}{pb:02X}", True, TEXT_NORM)
        surf.blit(rgb_txt, (self.sx+80, self.sy+265))

        # OK / Cancel
        ok_r   = pygame.Rect(self.sx+self.W-100, self.sy+self.H-36, 44, 26)
        can_r  = pygame.Rect(self.sx+self.W-52,  self.sy+self.H-36, 44, 26)
        mx_,my_ = pygame.mouse.get_pos()
        for r2,lbl,acol in [(ok_r,"OK",(50,100,180)),(can_r,"✕",(100,50,50))]:
            hov = r2.collidepoint(mx_,my_)
            pygame.draw.rect(surf, (70,120,220) if hov else acol, r2, border_radius=4)
            pygame.draw.rect(surf, (100,140,255), r2, 1, border_radius=4)
            t2 = font.render(lbl, True, (230,240,255))
            surf.blit(t2, t2.get_rect(center=r2.center))

    def handle(self, event):
        """Return True if event consumed."""
        if not self.visible: return False
        svr = self._sv_rect(); hr = self._hue_rect()
        ok_r  = pygame.Rect(self.sx+self.W-100, self.sy+self.H-36, 44, 26)
        can_r = pygame.Rect(self.sx+self.W-52,  self.sy+self.H-36, 44, 26)

        if event.type == pygame.MOUSEBUTTONDOWN and event.button==1:
            mx,my = event.pos
            if ok_r.collidepoint(mx,my):
                self.visible=False
                if self.callback: self.callback(self.current_rgb())
                return True
            if can_r.collidepoint(mx,my):
                self.visible=False; return True
            if svr.collidepoint(mx,my):
                self._drag_sv=True; self._update_sv(mx,my); return True
            if hr.collidepoint(mx,my):
                self._drag_hue=True; self._update_hue(mx); return True
            # outside all: close
            if not pygame.Rect(self.sx,self.sy,self.W,self.H).collidepoint(mx,my):
                self.visible=False; return False
            return True

        if event.type == pygame.MOUSEBUTTONUP:
            self._drag_sv=False; self._drag_hue=False

        if event.type == pygame.MOUSEMOTION:
            mx,my = event.pos
            if self._drag_sv:   self._update_sv(mx,my);  return True
            if self._drag_hue:  self._update_hue(mx);    return True

        return False

    def _update_sv(self,mx,my):
        svr = self._sv_rect()
        self.sat = max(0,min(1,(mx-svr.x)/svr.width))
        self.val = max(0,min(1,1-(my-svr.y)/svr.height))

    def _update_hue(self,mx):
        hr = self._hue_rect()
        self.hue = max(0,min(1,(mx-hr.x)/hr.width))


