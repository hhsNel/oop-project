class Editor:

    # ── init ──────────────────────────────────────────────────────────────────
    def __init__(self):
        pygame.init()
        pygame.key.set_repeat(400, 40)
        self.screen = pygame.display.set_mode((SCREEN_W, SCREEN_H), pygame.RESIZABLE)
        pygame.display.set_caption("Map Editor")
        self.clock  = pygame.time.Clock()

        self.font    = pygame.font.SysFont("monospace", 13)
        self.font_sm = pygame.font.SysFont("monospace", 11)
        self.font_lg = pygame.font.SysFont("monospace", 15, bold=True)
        self.font_hd = pygame.font.SysFont("monospace", 12, bold=True)

        self.map     = MapData()
        self.tool    = TOOL_LINE
        self.running = True

        # Viewport
        self.cam_x = 0.0; self.cam_y = 0.0; self.zoom = 1.0
        self.panning   = False
        self.pan_start = (0,0); self.pan_cam = (0.0,0.0)

        # Edit state
        self.sel_verts  = []
        self.sel_lines  = []
        self.hov_vert   = None
        self.hov_line   = None
        self.line_start = None
        self.cur_sector = 0
        self.hov_monster = None

        # BSP overlay
        self.show_bsp  = False
        self.bsp_nodes = []; self.bsp_subs = []
        self.bsp_verts = []; self.bsp_lines = []
        self.bsp_nc    = 0;  self.bsp_sc   = 0

        self.status = "V=vertex  L=line  S=paint sector  M=monster  E=select  D=delete  |  F5=export"
        self._flash_timer = 0

        self._build_panel()
        self._rebuild_bsp()

    # ── Panel construction ────────────────────────────────────────────────────

    def _build_panel(self):
        px = CANVAS_W + 10
        pw = PANEL_W - 20
        y  = 8

        def sep(extra=4):
            nonlocal y
            s = Separator(y+extra, CANVAS_W+4, SCREEN_W-4)
            self.widgets.append(s)
            y += extra*2+2

        def lbl(text, dy=4, color=TEXT_LABEL):
            nonlocal y
            w = Label(pygame.Rect(px, y, pw, 18), text, color=color)
            self.widgets.append(w)
            y += 18+dy

        def btn(label, h=30, accent=False):
            nonlocal y
            b = Button(pygame.Rect(px, y, pw, h), label, accent=accent)
            self.widgets.append(b)
            y += h+4
            return b

        def tbtn(label, tool_id, h=30):
            nonlocal y
            b = ToolButton(pygame.Rect(px, y, pw, h), label, tool_id)
            self.widgets.append(b)
            y += h+4
            return b

        def field(val="", num=False, h=28):
            nonlocal y
            f = TextInput(pygame.Rect(px, y, pw, h), val, numeric=num)
            self.widgets.append(f)
            y += h+4
            return f

        self.widgets = []

        # ── Tools ─────────────────────────────────────────────────────────────
        lbl("  TOOLS", color=TEXT_DIM); y += 2
        self.tb_vertex  = tbtn("✦  Vertex",  TOOL_VERTEX)
        self.tb_line    = tbtn("╱  Line",    TOOL_LINE)
        self.tb_sector  = tbtn("▣  Paint Sector", TOOL_SECTOR)
        self.tb_monster = tbtn("☠  Monster", TOOL_MONSTER)
        self.tb_select  = tbtn("⊹  Select",  TOOL_SELECT)
        self.tb_delete  = tbtn("✕  Delete",  TOOL_DELETE)
        self._tool_btns = [self.tb_vertex,self.tb_line,self.tb_sector,
                           self.tb_monster,self.tb_select,self.tb_delete]
        self.tb_line.active = True

        sep()

        # ── Monster props ─────────────────────────────────────────────────────
        lbl("  MONSTER", color=TEXT_DIM); y += 2
        lbl("Type ID (0-12):")
        self.fi_monster_type = field("2", num=True)
        lbl("Z height:")
        self.fi_monster_z = field("0.0", num=True)

        sep()

        # ── Sector props ──────────────────────────────────────────────────────
        lbl("  SECTOR", color=TEXT_DIM); y += 2
        lbl("Index:")
        self.fi_sec_idx = field("0", num=True)
        self.btn_new_sec = btn("+ New Sector")
        lbl("Floor height:")
        self.fi_floor_h  = field("0.0", num=True)
        lbl("Ceiling height:")
        self.fi_ceil_h   = field("128.0", num=True)
        lbl("Floor tex ID:")
        self.fi_floor_tex= field("0", num=True)
        lbl("Ceiling tex ID:")
        self.fi_ceil_tex = field("0", num=True)
        lbl("Light (0-255):")
        self.fi_light    = field("200", num=True)
        self.btn_apply   = btn("Apply Sector", accent=True)

        sep()

        # ── Sidedef textures ──────────────────────────────────────────────────
        lbl("  SIDEDEF TEXTURES", color=TEXT_DIM); y += 2
        lbl("Upper tex:")
        self.fi_upper = field("0", num=True)
        lbl("Mid tex:")
        self.fi_mid   = field("1", num=True)
        lbl("Lower tex:")
        self.fi_lower = field("0", num=True)

        sep()

        # ── File ops ──────────────────────────────────────────────────────────
        lbl("  FILE / BSP", color=TEXT_DIM); y += 2
        self.btn_bsp    = btn("Show BSP Overlay")
        self.btn_export = btn("◉  Export Binary", accent=True)
        self.btn_save   = btn("💾  Save JSON")
        self.btn_load   = btn("📂  Load JSON")
        self.btn_clear  = btn("⊘  Clear Map")

        # store y for info block at bottom
        self._info_y = max(y, SCREEN_H - 200)

    # ── Widget helpers ────────────────────────────────────────────────────────

    def _int(self, fi, default=0):
        try:    return int(float(fi.text))
        except: return default

    def _flt(self, fi, default=0.0):
        try:    return float(fi.text)
        except: return default

    def _all_inputs(self):
        return [w for w in self.widgets if isinstance(w, TextInput)]

    def _any_input_active(self):
        return any(w.active for w in self._all_inputs())

    # ── Coord helpers ─────────────────────────────────────────────────────────

    def w2s(self, wx, wy):
        sx = (wx-self.cam_x)*self.zoom + CANVAS_W/2
        sy = (-wy+self.cam_y)*self.zoom + CANVAS_H/2
        return int(sx), int(sy)

    def s2w(self, sx, sy):
        wx = (sx - CANVAS_W/2)/self.zoom + self.cam_x
        wy = -((sy - CANVAS_H/2)/self.zoom - self.cam_y)
        return wx, wy

    def snap(self, wx, wy):
        s=SNAP
        return round(wx/s)*s, round(wy/s)*s

    def near_vert(self, wx, wy, r=14):
        best=None; bd=r/self.zoom
        for i,v in enumerate(self.map.vertices):
            d=math.hypot(v.x-wx,v.y-wy)
            if d<bd: best,bd=i,d
        return best

    def near_line(self, wx, wy, r=8):
        best=None; bd=r/self.zoom
        for i,l in enumerate(self.map.linedefs):
            v0=self.map.vertices[l.v0]; v1=self.map.vertices[l.v1]
            d=self._pt_seg(wx,wy,v0.x,v0.y,v1.x,v1.y)
            if d<bd: best,bd=i,d
        return best

    def _pt_seg(self,px,py,ax,ay,bx,by):
        dx,dy=bx-ax,by-ay; l2=dx*dx+dy*dy
        if l2<1e-10: return math.hypot(px-ax,py-ay)
        t=max(0,min(1,((px-ax)*dx+(py-ay)*dy)/l2))
        return math.hypot(px-(ax+t*dx),py-(ay+t*dy))

    def near_monster(self, wx, wy, r=14):
        best=None; bd=r/self.zoom
        for i,m in enumerate(self.map.monsters):
            d=math.hypot(m.x-wx,m.y-wy)
            if d<bd: best,bd=i,d
        return best

    # ── Sector/sidedef helpers ────────────────────────────────────────────────

    def _ensure_sector(self):
        while len(self.map.sectors) <= self.cur_sector:
            ci = len(self.map.sectors) % len(SECTOR_FILLS)
            self.map.sectors.append(Sector(color_idx=ci))

    def _get_sidedef(self, sec_idx):
        ut=self._int(self.fi_upper,0); mt=self._int(self.fi_mid,1); lt=self._int(self.fi_lower,0)
        for i,sd in enumerate(self.map.sidedefs):
            if sd.facing_sector==sec_idx and sd.upper_tex==ut and sd.mid_tex==mt and sd.lower_tex==lt:
                return i
        self.map.sidedefs.append(Sidedef(sec_idx,ut,mt,lt))
        return len(self.map.sidedefs)-1

    def _sync_sector_fields(self):
        if self.cur_sector < len(self.map.sectors):
            s=self.map.sectors[self.cur_sector]
            self.fi_floor_h.set(s.floor_h); self.fi_ceil_h.set(s.ceil_h)
            self.fi_floor_tex.set(s.floor_tex); self.fi_ceil_tex.set(s.ceil_tex)
            self.fi_light.set(s.light)

    # ── BSP cache ─────────────────────────────────────────────────────────────

    def _rebuild_bsp(self):
        if not self.map.linedefs:
            self.bsp_nodes=[]; self.bsp_subs=[]; self.bsp_nc=0; self.bsp_sc=0; return
        n,s,wl,wv = build_bsp(self.map)
        self.bsp_nodes=n; self.bsp_subs=s; self.bsp_lines=wl; self.bsp_verts=wv
        self.bsp_nc=len(n); self.bsp_sc=len(s)

    # ── Drawing ───────────────────────────────────────────────────────────────

    def _draw_grid(self, surf):
        wl,wt = self.s2w(0,0); wr,wb = self.s2w(CANVAS_W,CANVAS_H)
        s=GRID
        x=int(wl//s)*s
        while x<=wr+s:
            sx,_=self.w2s(x,0)
            if 0<=sx<=CANVAS_W:
                col = GRID_MAJ if x%(s*4)==0 else GRID_MIN
                pygame.draw.line(surf,col,(sx,0),(sx,CANVAS_H))
            x+=s
        y=int(wb//s)*s
        while y<=wt+s:
            _,sy=self.w2s(0,y)
            if 0<=sy<=CANVAS_H:
                col = GRID_MAJ if y%(s*4)==0 else GRID_MIN
                pygame.draw.line(surf,col,(0,sy),(CANVAS_W,sy))
            y+=s
        ox,oy=self.w2s(0,0)
        pygame.draw.line(surf,ORIGIN_COL,(ox,0),(ox,CANVAS_H))
        pygame.draw.line(surf,ORIGIN_COL,(0,oy),(CANVAS_W,oy))

    def _draw_sector_fills(self, surf):
        alpha = pygame.Surface((CANVAS_W,CANVAS_H), pygame.SRCALPHA)
        sec_vids = {}
        for l in self.map.linedefs:
            if l.front!=NULL_ID and l.front<len(self.map.sidedefs):
                si=self.map.sidedefs[l.front].facing_sector
                sec_vids.setdefault(si,[]).extend([l.v0,l.v1])
        for si,vis in sec_vids.items():
            vis=list(dict.fromkeys(vis))
            if len(vis)<3 or si>=len(self.map.sectors): continue
            s=self.map.sectors[si]
            col=SECTOR_FILLS[s.color_idx%len(SECTOR_FILLS)]
            cx=sum(self.map.vertices[i].x for i in vis)/len(vis)
            cy=sum(self.map.vertices[i].y for i in vis)/len(vis)
            vis=sorted(vis, key=lambda i: math.atan2(
                self.map.vertices[i].y-cy, self.map.vertices[i].x-cx))
            pts=[self.w2s(self.map.vertices[i].x,self.map.vertices[i].y) for i in vis]
            if len(pts)>=3:
                pygame.draw.polygon(alpha,col,pts)
        surf.blit(alpha,(0,0))

    def _draw_bsp(self, surf):
        if not self.bsp_nodes: return
        alpha=pygame.Surface((CANVAS_W,CANVAS_H),pygame.SRCALPHA)
        # subsector coloured lines
        for si,sub in enumerate(self.bsp_subs):
            col=BSP_COLS[si%len(BSP_COLS)]
            for li in sub:
                l=self.bsp_lines[li]
                p0=self.w2s(self.bsp_verts[l.v0].x,self.bsp_verts[l.v0].y)
                p1=self.w2s(self.bsp_verts[l.v1].x,self.bsp_verts[l.v1].y)
                pygame.draw.line(alpha,(*col,200),p0,p1,2)
        # partition planes (faint)
        for ni,n in enumerate(self.bsp_nodes):
            if n is None: continue
            col=(*BSP_COLS[ni%len(BSP_COLS)],35)
            EXT=3000
            p1=self.w2s(n.pl_x+n.dir_x*EXT, n.pl_y+n.dir_y*EXT)
            p2=self.w2s(n.pl_x-n.dir_x*EXT, n.pl_y-n.dir_y*EXT)
            pygame.draw.line(alpha,col,p1,p2,1)
        surf.blit(alpha,(0,0))

    def _draw_lines(self, surf):
        for i,l in enumerate(self.map.linedefs):
            v0=self.map.vertices[l.v0]; v1=self.map.vertices[l.v1]
            p0=self.w2s(v0.x,v0.y); p1=self.w2s(v1.x,v1.y)
            if i in self.sel_lines: col=LINE_SEL; w=3
            elif i==self.hov_line:  col=LINE_SEL; w=2
            elif l.back==NULL_ID:   col=LINE_WALL; w=2
            else:                   col=LINE_PORT; w=2
            pygame.draw.line(surf,col,p0,p1,w)
            # direction tick
            mx,my=(p0[0]+p1[0])//2,(p0[1]+p1[1])//2
            dx,dy=v1.x-v0.x,v1.y-v0.y; ln=math.hypot(dx,dy)
            if ln>0:
                nx,ny=-dy/ln,-dx/ln
                tx,ty=int(mx+ny*9),int(my+nx*9)
                pygame.draw.line(surf,col,(mx,my),(tx,ty),1)

    def _draw_verts(self, surf):
        for i,v in enumerate(self.map.vertices):
            sx,sy=self.w2s(v.x,v.y)
            if i in self.sel_verts:    col=LINE_SEL; r=6
            elif i==self.hov_vert:     col=VERTEX_HOV; r=6
            elif i==self.line_start:   col=(255,200,80); r=6
            else:                      col=VERTEX_C; r=4
            pygame.draw.circle(surf,col,(sx,sy),r)
            pygame.draw.circle(surf,(10,12,20),(sx,sy),r,1)

    def _draw_monsters(self, surf):
        for i,m in enumerate(self.map.monsters):
            sx,sy=self.w2s(m.x,m.y)
            col=MONSTER_HOV if i==self.hov_monster else MONSTER_COL
            r=7
            pygame.draw.circle(surf,col,(sx,sy),r)
            pygame.draw.circle(surf,(10,12,20),(sx,sy),r,1)
            name=MONSTER_NAMES[m.monster_type] if m.monster_type<len(MONSTER_NAMES) else "?"
            txt=self.font_sm.render(name,True,col)
            surf.blit(txt,(sx-txt.get_width()//2,sy-r-14))

    def _draw_preview(self, surf, mx, my):
        if self.line_start is None: return
        v=self.map.vertices[self.line_start]
        p0=self.w2s(v.x,v.y)
        wx,wy=self.s2w(mx,my); wx,wy=self.snap(wx,wy)
        hv=self.near_vert(wx,wy,20)
        if hv is not None:
            wx,wy=self.map.vertices[hv].x,self.map.vertices[hv].y
        p1=self.w2s(wx,wy)
        pygame.draw.line(surf,LINE_PREV,p0,p1,1)
        pygame.draw.circle(surf,LINE_PREV,p1,4,1)

    def _draw_panel(self, surf):
        pygame.draw.rect(surf,PANEL_BG,(CANVAS_W,0,PANEL_W,SCREEN_H))
        pygame.draw.line(surf,(45,50,75),(CANVAS_W,0),(CANVAS_W,SCREEN_H),2)

        for w in self.widgets:
            w.draw(surf, self.font, self.font_sm)

        # Stats block near bottom
        y=SCREEN_H-195
        stats=[
            ("Vertices",  len(self.map.vertices)),
            ("Linedefs",  len(self.map.linedefs)),
            ("Sectors",   len(self.map.sectors)),
            ("Sidedefs",  len(self.map.sidedefs)),
            ("Monsters",  len(self.map.monsters)),
            ("BSP nodes", self.bsp_nc),
            ("Subsectors",self.bsp_sc),
            ("Sector #",  self.cur_sector),
            ("Zoom",      f"{self.zoom:.2f}x"),
        ]
        pygame.draw.line(surf,PANEL_LINE,(CANVAS_W+4,y-8),(SCREEN_W-4,y-8))
        txt=self.font_hd.render("  STATS",True,TEXT_DIM)
        surf.blit(txt,(CANVAS_W+10,y-6))
        y+=14
        for k,v in stats:
            kt=self.font_sm.render(f"{k}:",True,TEXT_DIM)
            vt=self.font_sm.render(str(v),True,TEXT_NORM)
            surf.blit(kt,(CANVAS_W+12,y))
            surf.blit(vt,(SCREEN_W-12-vt.get_width(),y))
            y+=16

    def _draw_statusbar(self, surf):
        pygame.draw.rect(surf,(12,14,22),(0,CANVAS_H-22,CANVAS_W,22))
        pygame.draw.line(surf,(40,45,65),(0,CANVAS_H-22),(CANVAS_W,CANVAS_H-22),1)
        # Tool badge
        tool_labels = {TOOL_VERTEX:"✦ VERTEX",TOOL_LINE:"╱ LINE",
                       TOOL_SECTOR:"▣ PAINT",TOOL_MONSTER:"☠ MONSTER",
                       TOOL_SELECT:"⊹ SELECT",TOOL_DELETE:"✕ DELETE"}
        badge=self.font_hd.render(f" {tool_labels[self.tool]} ",True,(20,22,32))
        bs=badge.get_rect(); bs.inflate_ip(8,4)
        bs.topleft=(6,CANVAS_H-20)
        pygame.draw.rect(surf,ACCENT,bs,border_radius=3)
        surf.blit(badge,(bs.x+4,bs.y+2))
        # Status message
        st=self.font_sm.render(self.status,True,TEXT_NORM)
        surf.blit(st,(bs.right+10,CANVAS_H-16))

    def _draw_coord(self, surf, mx, my):
        if mx>=CANVAS_W: return
        wx,wy=self.s2w(mx,my); swx,swy=self.snap(wx,wy)
        coord=self.font_sm.render(f"({int(swx)},{int(swy)})",True,TEXT_DIM)
        surf.blit(coord,(mx+12,my-16))

    # ── Mouse on canvas ───────────────────────────────────────────────────────

    def _canvas_mouse(self, event, mx, my):
        wx,wy=self.s2w(mx,my); swx,swy=self.snap(wx,wy)

        if event.type==pygame.MOUSEBUTTONDOWN:
            if event.button==2:
                self.panning=True; self.pan_start=(mx,my)
                self.pan_cam=(self.cam_x,self.cam_y)
            elif event.button==1:
                if not self._any_input_active():
                    self._lmb(swx,swy,wx,wy)

        elif event.type==pygame.MOUSEBUTTONUP:
            if event.button==2: self.panning=False

        elif event.type==pygame.MOUSEMOTION:
            if self.panning:
                dx=(mx-self.pan_start[0])/self.zoom
                dy=(my-self.pan_start[1])/self.zoom
                self.cam_x=self.pan_cam[0]-dx
                self.cam_y=self.pan_cam[1]+dy
            else:
                self.hov_vert=self.near_vert(wx,wy,14)
                self.hov_line=self.near_line(wx,wy,8)
                self.hov_monster=self.near_monster(wx,wy,14)

        elif event.type==pygame.MOUSEWHEEL:
            fac=1.15 if event.y>0 else 1/1.15
            old_z=self.zoom
            self.zoom=max(0.04,min(20.0,self.zoom*fac))
            self.cam_x+=(wx-self.cam_x)*(1-old_z/self.zoom)
            self.cam_y+=(wy-self.cam_y)*(1-old_z/self.zoom)

    def _lmb(self, swx, swy, wx, wy):
        t=self.tool

        if t==TOOL_VERTEX:
            vi=self.near_vert(wx,wy,14)
            if vi is None:
                self.map.vertices.append(Vertex(swx,swy))
                self.status=f"Vertex added at ({int(swx)},{int(swy)})"
            self._rebuild_bsp()

        elif t==TOOL_LINE:
            vi=self.near_vert(wx,wy,14)
            if vi is None:
                self.map.vertices.append(Vertex(swx,swy)); vi=len(self.map.vertices)-1
            if self.line_start is None:
                self.line_start=vi
                self.status=f"Line start: vertex #{vi} — click to place end"
            else:
                if vi!=self.line_start:
                    self._ensure_sector()
                    sd=self._get_sidedef(self.cur_sector)
                    self.map.linedefs.append(Linedef(self.line_start,vi,sd,NULL_ID))
                    self.status=f"Linedef #{len(self.map.linedefs)-1} added  (sector {self.cur_sector})"
                self.line_start=vi
                self._rebuild_bsp()

        elif t==TOOL_SECTOR:
            li=self.near_line(wx,wy,12)
            if li is not None:
                self._ensure_sector(); sd=self._get_sidedef(self.cur_sector)
                l=self.map.linedefs[li]
                side=_seg_side(self.map.vertices[l.v0].x,self.map.vertices[l.v0].y,
                               self.map.vertices[l.v1].x,self.map.vertices[l.v1].y,wx,wy)
                if side>=0: self.map.linedefs[li]=Linedef(l.v0,l.v1,sd,l.back)
                else:       self.map.linedefs[li]=Linedef(l.v0,l.v1,l.front,sd)
                self.status=f"Painted sector {self.cur_sector} on line #{li}"
                self._rebuild_bsp()

        elif t==TOOL_SELECT:
            vi=self.near_vert(wx,wy,14); li=self.near_line(wx,wy,8)
            if not pygame.key.get_mods()&pygame.KMOD_SHIFT:
                self.sel_verts=[]; self.sel_lines=[]
            if vi is not None:
                if vi in self.sel_verts: self.sel_verts.remove(vi)
                else: self.sel_verts.append(vi)
                v=self.map.vertices[vi]
                self.status=f"Vertex #{vi} at ({int(v.x)},{int(v.y)})"
            elif li is not None:
                if li in self.sel_lines: self.sel_lines.remove(li)
                else: self.sel_lines.append(li)
                l=self.map.linedefs[li]
                bs="wall" if l.back==NULL_ID else str(l.back)
                self.status=f"Line #{li}  v{l.v0}→v{l.v1}  front={l.front} back={bs}"

        elif t==TOOL_MONSTER:
            mt=max(0,min(len(MONSTER_NAMES)-1,self._int(self.fi_monster_type,2)))
            mz=self._flt(self.fi_monster_z,0.0)
            self.map.monsters.append(MonsterSpawn(swx,swy,mt,mz))
            name=MONSTER_NAMES[mt]
            self.status=f"Monster '{name}' placed at ({int(swx)},{int(swy)})"

        elif t==TOOL_DELETE:
            mi=self.near_monster(wx,wy,14)
            vi=self.near_vert(wx,wy,14); li=self.near_line(wx,wy,8)
            if mi is not None:
                self.map.monsters.pop(mi)
                self.status=f"Deleted monster #{mi}"
            elif vi is not None:
                self.map.linedefs=[l for l in self.map.linedefs if l.v0!=vi and l.v1!=vi]
                self.map.vertices.pop(vi)
                for i,l in enumerate(self.map.linedefs):
                    v0=l.v0 if l.v0<vi else l.v0-1
                    v1=l.v1 if l.v1<vi else l.v1-1
                    self.map.linedefs[i]=Linedef(v0,v1,l.front,l.back)
                self.status=f"Deleted vertex #{vi}"
            elif li is not None:
                self.map.linedefs.pop(li)
                self.status=f"Deleted linedef #{li}"
            self.sel_verts=[]; self.sel_lines=[]
            self._rebuild_bsp()

    # ── Button actions ────────────────────────────────────────────────────────

    def _btn_action(self, btn):
        if btn==self.btn_new_sec:
            ci=len(self.map.sectors)%len(SECTOR_FILLS)
            self.map.sectors.append(Sector(color_idx=ci))
            self.cur_sector=len(self.map.sectors)-1
            self.fi_sec_idx.set(self.cur_sector)
            self._sync_sector_fields()
            self.status=f"Created sector #{self.cur_sector}"

        elif btn==self.btn_apply:
            idx=self._int(self.fi_sec_idx,0)
            while len(self.map.sectors)<=idx:
                ci=len(self.map.sectors)%len(SECTOR_FILLS)
                self.map.sectors.append(Sector(color_idx=ci))
            self.cur_sector=idx
            s=self.map.sectors[idx]
            s.floor_h  =self._flt(self.fi_floor_h,0.0)
            s.ceil_h   =self._flt(self.fi_ceil_h,128.0)
            s.floor_tex=self._int(self.fi_floor_tex,0)
            s.ceil_tex =self._int(self.fi_ceil_tex,0)
            s.light    =max(0,min(255,self._int(self.fi_light,200)))
            self.status=f"Sector #{idx} updated"

        elif btn==self.btn_bsp:
            self.show_bsp=not self.show_bsp
            self.btn_bsp.label="Hide BSP Overlay" if self.show_bsp else "Show BSP Overlay"
            self._rebuild_bsp()

        elif btn==self.btn_export:
            try:
                ns,nl,nb,nss,nm=export_bin(self.map,"map_output")
                self.status=f"Exported → map_output/  ({ns} sectors, {nl} lines, {nb} nodes, {nss} subs, {nm} monsters)"
            except Exception as e:
                self.status=f"Export error: {e}"

        elif btn==self.btn_save:
            try:
                save_json(self.map,"map.json")
                self.status="Saved to map.json"
            except Exception as e:
                self.status=f"Save error: {e}"

        elif btn==self.btn_load:
            try:
                self.map=load_json("map.json")
                self._rebuild_bsp()
                self.status=f"Loaded map.json — {len(self.map.linedefs)} lines"
            except Exception as e:
                self.status=f"Load error: {e}"

        elif btn==self.btn_clear:
            self.map.clear(); self.line_start=None
            self.sel_verts=[]; self.sel_lines=[]
            self._rebuild_bsp(); self.status="Map cleared."

        elif isinstance(btn, ToolButton):
            for tb in self._tool_btns: tb.active=False
            btn.active=True; self.tool=btn.tool_id
            if btn.tool_id!=TOOL_LINE: self.line_start=None

    # ── Main loop ─────────────────────────────────────────────────────────────

    def run(self):
        mx=my=0
        while self.running:
            dt_ms=self.clock.tick(60)

            for event in pygame.event.get():
                if event.type==pygame.QUIT: self.running=False

                # Pass events to all input fields first
                for w in self._all_inputs():
                    w.handle(event)

                # Check for button clicks
                for w in self.widgets:
                    if isinstance(w,(Button,ToolButton)) and w.handle(event):
                        self._btn_action(w)

                # Keyboard shortcuts (only when no input focused)
                if event.type==pygame.KEYDOWN and not self._any_input_active():
                    k=event.key
                    if   k==pygame.K_ESCAPE: self.line_start=None; self.sel_verts=[]; self.sel_lines=[]
                    elif k==pygame.K_v: self._btn_action(self.tb_vertex)
                    elif k==pygame.K_l: self._btn_action(self.tb_line)
                    elif k==pygame.K_s: self._btn_action(self.tb_sector)
                    elif k==pygame.K_m: self._btn_action(self.tb_monster)
                    elif k==pygame.K_e: self._btn_action(self.tb_select)
                    elif k==pygame.K_d: self._btn_action(self.tb_delete)
                    elif k==pygame.K_b: self._btn_action(self.btn_bsp)
                    elif k==pygame.K_HOME: self.cam_x=0; self.cam_y=0; self.zoom=1.0
                    elif k==pygame.K_F5:
                        try:
                            ns,nl,nb,nss,nm=export_bin(self.map,"map_output")
                            self.status=f"[F5] Exported: {ns} sec, {nl} lines, {nb} nodes, {nss} subs, {nm} monsters"
                        except Exception as ex:
                            self.status=f"Export error: {ex}"
                    elif k==pygame.K_DELETE and self.sel_lines:
                        for li in sorted(self.sel_lines,reverse=True):
                            if li<len(self.map.linedefs): self.map.linedefs.pop(li)
                        self.sel_lines=[]; self._rebuild_bsp()

                # Canvas mouse
                if event.type in (pygame.MOUSEBUTTONDOWN,pygame.MOUSEBUTTONUP,
                                  pygame.MOUSEMOTION,pygame.MOUSEWHEEL):
                    if event.type==pygame.MOUSEMOTION: mx,my=event.pos
                    elif hasattr(event,'pos'): mx,my=event.pos
                    if mx<CANVAS_W:
                        self._canvas_mouse(event,mx,my)
                    elif event.type==pygame.MOUSEMOTION:
                        self.hov_vert=None; self.hov_line=None

                # Panel hover update
                for w in self.widgets:
                    if isinstance(w,(Button,ToolButton)): w.update(mx,my)

            # Update text inputs
            for w in self._all_inputs(): w.update(dt_ms)

            # Sync sector index field → cur_sector
            try:
                idx=int(float(self.fi_sec_idx.text))
                if not self.fi_sec_idx.active and idx!=self.cur_sector:
                    self.cur_sector=idx; self._sync_sector_fields()
            except: pass

            # ── Render ────────────────────────────────────────────────────────
            self.screen.fill(BG,(0,0,CANVAS_W,CANVAS_H))
            self._draw_grid(self.screen)
            self._draw_sector_fills(self.screen)
            if self.show_bsp: self._draw_bsp(self.screen)
            self._draw_lines(self.screen)
            if self.tool==TOOL_LINE: self._draw_preview(self.screen,mx,my)
            self._draw_verts(self.screen)
            self._draw_monsters(self.screen)
            self._draw_statusbar(self.screen)
            if mx<CANVAS_W: self._draw_coord(self.screen,mx,my)
            self._draw_panel(self.screen)
            pygame.display.flip()

        pygame.quit()

