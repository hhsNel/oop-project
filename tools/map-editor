    def _pt_seg(self,px,py,ax,ay,bx,by):
        dx,dy=bx-ax,by-ay; l2=dx*dx+dy*dy
        if l2<1e-10: return math.hypot(px-ax,py-ay)
        t=max(0,min(1,((px-ax)*dx+(py-ay)*dy)/l2))
        return math.hypot(px-(ax+t*dx),py-(ay+t*dy))

    def _pt_in_polygon(self, px, py, poly_pts):
        """Ray-cast point-in-polygon."""
        n = len(poly_pts); inside = False
        j = n-1
        for i in range(n):
            xi,yi = poly_pts[i]; xj,yj = poly_pts[j]
            if ((yi>py)!=(yj>py)) and (px < (xj-xi)*(py-yi)/(yj-yi+1e-12)+xi):
                inside = not inside
            j=i
        return inside

    def _trace_polygon(self, edges, verts_lookup):
        """
        Given a list of (v0, v1) edges and a callable verts_lookup(i)->(x,y),
        attempt to chain them into an ordered polygon by following connections.
        Falls back to convex-hull angle sort only when the chain is broken.
        Returns list of (x,y) or None.
        """
        if not edges: return None

        # Build adjacency: vertex -> list of connected vertices
        adj = {}
        for a, b in edges:
            adj.setdefault(a, []).append(b)
            adj.setdefault(b, []).append(a)

        # Try to walk a closed chain starting from the vertex with lowest degree
        # (or any vertex). We pick a start and greedily follow unvisited neighbours.
        all_verts = list(adj.keys())
        if len(all_verts) < 3: return None

        start = all_verts[0]
        chain = [start]
        visited_edges = set()
        cur = start

        while True:
            neighbours = adj.get(cur, [])
            # prefer unvisited edge; among those prefer the one that continues
            # the current direction (avoids doubling back on T-junctions)
            nxt = None
            for nb in neighbours:
                key = (min(cur,nb), max(cur,nb))
                if key not in visited_edges:
                    nxt = nb
                    break
            if nxt is None:
                break
            key = (min(cur,nxt), max(cur,nxt))
            visited_edges.add(key)
            if nxt == start:
                break   # closed the loop
            if nxt in chain:
                # hit a vertex we already visited but haven't closed — give up
                break
            chain.append(nxt)
            cur = nxt

        if len(chain) < 3:
            return None

        return [verts_lookup(i) for i in chain]

    def _sector_polygon(self, si):
        """Return world-space polygon for sector si (or None)."""
        edges = []
        for l in self.map.linedefs:
            if l.front!=NULL_ID and l.front<len(self.map.sidedefs):
                if self.map.sidedefs[l.front].facing_sector == si:
                    edges.append((l.v0, l.v1))
        def lookup(i): return (self.map.vertices[i].x, self.map.vertices[i].y)
        return self._trace_polygon(edges, lookup)

    def _subsector_polygon(self, si):
        """Return world-space polygon for BSP subsector si (or None)."""
        if si >= len(self.bsp_subs): return None
        sub = self.bsp_subs[si]
        edges = [(self.bsp_lines[li].v0, self.bsp_lines[li].v1) for li in sub]
        def lookup(i): return (self.bsp_verts[i].x, self.bsp_verts[i].y)
        return self._trace_polygon(edges, lookup)

