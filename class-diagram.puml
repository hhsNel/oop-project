package "game_pkg" {
    class game {
        - resource_loader rl
        - asset_manager am
        - unique_ptr<input_backend> input
        - unique_ptr<rendering_backend> rb
        - unique_ptr<audio_backend> ab
        - map_data md
        - audio_mixer mix
        - renderer_2d r2d
        - software_renderer sr
        - world w
        - float fov
        + game()
        + void run()
        - void text_scroll(vector<string>, audio_clip_id)
        - void opening()
        - void ending()
        - void credits()
        - void show_main_menu()
        - void show_options()
        - void loop()
    }

    game *-- util.resource_loader
    game *-- assets.asset_manager
    game *-- input.input_backend
    game *-- rendering.rendering_backend
    game *-- audio.audio_backend
    game *-- geometry.map_data
    game *-- audio.audio_mixer
    game *-- rendering.renderer_2d
    game *-- rendering.software_renderer
    game *-- engine.world
}

